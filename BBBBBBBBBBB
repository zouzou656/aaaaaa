1) Enhanced Exporter — export_dev_jca.py

# =============================================================================
# export_dev_jca.py — Export DEV config to JSON (incl. JCA Adapter JNDIs)
# Usage: $WL_HOME/common/bin/wlst.sh export_dev_jca.py
# Notes:
#  - WLST/Jython safe: no ternaries, no "with open", no time module.
#  - Writes valid JSON with built-in writer (no json/simplejson dependency).
#  - Captures: targets, applications (filtered), JDBC, JMS, and JCA (adapter JNDIs).
# =============================================================================

# ----------------------- USER SETTINGS ---------------------------------------
ADMIN_URL  = 't3s://dev-admin-host:7002'   # <-- change
ADMIN_USER = 'weblogic'                    # <-- change
ADMIN_PASS = '***'                         # <-- change

OUT_DIR    = './export'

# JCA adapters to include (add/remove as needed)
JCA_ADAPTERS = [
  'JmsAdapter', 'DbAdapter', 'FtpAdapter', 'AqAdapter',
  'FileAdapter', 'SocketAdapter', 'SAPAdapter',
  'MQSeriesAdapter', 'LdapAdapter', 'MSMQAdapter',
  'OracleAppsAdapter', 'JDEWorldAdapter', 'Cloudsdk'
]

# ----------------------- IMPORTS / RUNTIME -----------------------------------
import os
from datetime import datetime
from javax.management import ObjectName

# ----------------------- MINIMAL JSON WRITER ---------------------------------
def _json_escape(s):
    if s is None: return 'null'
    s = str(s)
    out = []
    i = 0
    while i < len(s):
        ch = s[i]; code = ord(ch)
        if ch == '"': out.append('\\"')
        elif ch == '\\': out.append('\\\\')
        elif ch == '\b': out.append('\\b')
        elif ch == '\f': out.append('\\f')
        elif ch == '\n': out.append('\\n')
        elif ch == '\r': out.append('\\r')
        elif ch == '\t': out.append('\\t')
        elif code < 0x20 or code == 0x2028 or code == 0x2029:
            out.append('\\u%04x' % code)
        else:
            out.append(ch)
        i += 1
    return '"' + ''.join(out) + '"'

def _to_json(o):
    if o is None: return 'null'
    t = str(type(o))
    try:
        if o is True:  return 'true'
        if o is False: return 'false'
    except: pass
    if t.find('int')!=-1 or t.find('long')!=-1 or t.find('float')!=-1 or t.find('double')!=-1:
        return str(o)
    if t.find('str')!=-1 or t.find('unicode')!=-1 or t.find('java.lang.String')!=-1:
        return _json_escape(o)
    if isinstance(o, list) or isinstance(o, tuple):
        parts=[]; i=0
        while i<len(o): parts.append(_to_json(o[i])); i+=1
        return '['+','.join(parts)+']'
    if isinstance(o, dict):
        parts=[]; ks=o.keys()
        i=0
        while i<len(ks):
            k=ks[i]; parts.append(_json_escape(k)+':'+_to_json(o[k])); i+=1
        return '{'+','.join(parts)+'}'
    return _json_escape(str(o))

def write_json(path, obj):
    d = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(d): os.makedirs(d)
    fw = open(path, 'w'); fw.write(_to_json(obj)); fw.close()

# ----------------------- FILTERS (tune as needed) ----------------------------
_EXCLUDE_APP_PREFIX = (
  'em','wsm-pm','wsm-cache','dms','coherence','weblogic',
  'opss','oracle.bi','oracle.dms','oracledi','soa-infra','mft',
  'bpm','adminconsole','bea_wls9_async_response','ums','wls-wsat'
)
_EXCLUDE_APP_CONTAINS = ('#','coherence-transaction','-rar','management','wlfullclient')

_EXCLUDE_JDBC_PREFIX = (
  'SOADataSource','EDNDataSource','EDNLocalTxDataSource','OraSDPMDataSource',
  'mds-','opss-','wlsbjmsrp','WLSSchemaDataSource','LocalSvcTblDataSource',
  'SOALocalTxDataSource','SOA_MDS','FMwDT','FMWDT','Audit','bam','mds-owsm',
  'SOAINFRA','ESSDS','UmsDataSource','RSMANAGEDDS','STBDataSource'
)

_EXCLUDE_JMS_PREFIX = (
  'UMSJMSServer','UMSJMSSystemResource','SOAJMSModule','EDN',
  'BPM','wlsbJMSServer','WseeJmsModule','WLSJMSModule'
)

def _skip_app(name):
    if name is None: return True
    low=name.lower(); i=0
    while i<len(_EXCLUDE_APP_PREFIX):
        if low.startswith(_EXCLUDE_APP_PREFIX[i]): return True
        i+=1
    j=0
    while j<len(_EXCLUDE_APP_CONTAINS):
        if low.find(_EXCLUDE_APP_CONTAINS[j])!=-1: return True
        j+=1
    return False

def _skip_jdbc(name):
    if name is None: return True
    low=name.lower(); i=0
    while i<len(_EXCLUDE_JDBC_PREFIX):
        if low.startswith(_EXCLUDE_JDBC_PREFIX[i].lower()): return True
        i+=1
    return False

def _skip_jms(name):
    if name is None: return True
    low=name.lower(); i=0
    while i<len(_EXCLUDE_JMS_PREFIX):
        if low.startswith(_EXCLUDE_JMS_PREFIX[i].lower()): return True
        i+=1
    return False

def _safe_str(v): return None if v is None else str(v)

# ----------------------- EXPORT ----------------------------------------------
def main():
    connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
    domainConfig()

    ts_file = datetime.now().strftime('%Y%m%d-%H%M%S')
    ts_hum  = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    out_dir_abs = os.path.abspath(OUT_DIR)
    if not os.path.isdir(out_dir_abs): os.makedirs(out_dir_abs)

    manifest = {
        'domainVersion': None,
        'exportedAt': ts_hum,
        'adminUrl': ADMIN_URL,
        'targets': {},
        'applications': [],
        'libraries': [],
        'jdbc': [],
        'jms': [],
        'jca': []   # << NEW: per-adapter connection-instances (JNDIs)
    }

    # Domain version
    try:
        cd('/'); manifest['domainVersion'] = _safe_str(cmo.getDomainVersion())
    except: pass

    # Targets (Servers/Clusters)
    try:
        cd('/')
        srvs = cmo.getServers()
        if srvs:
            i=0
            while i<len(srvs):
                s=srvs[i]; manifest['targets'][s.getName()]={'type':'Server'}; i+=1
        cls = cmo.getClusters()
        if cls:
            j=0
            while j<len(cls):
                c=cls[j]; manifest['targets'][c.getName()]={'type':'Cluster'}; j+=1
    except: pass

    # Applications
    try:
        cd('/AppDeployments')
        apps = cmo.getAppDeployments()
        if apps:
            i=0
            while i<len(apps):
                app=apps[i]; i+=1
                name=app.getName()
                if _skip_app(name): continue
                tgts=[]
                try:
                    cd('/AppDeployments/'+name+'/Targets')
                    t=cmo.getTargets()
                    if t:
                        k=0
                        while k<len(t):
                            tgts.append(t[k].getName()); k+=1
                except: pass
                cd('/')
                manifest['applications'].append({'name':name,'targets':tgts})
    except: pass

    # Libraries
    try:
        cd('/Libraries')
        libs = cmo.getLibraries()
        if libs:
            i=0
            while i<len(libs):
                lib=libs[i]; i+=1
                name=lib.getName()
                if _skip_app(name): continue
                tgts=[]
                try:
                    cd('/Libraries/'+name+'/Targets')
                    t=cmo.getTargets()
                    if t:
                        k=0
                        while k<len(t):
                            tgts.append(t[k].getName()); k+=1
                except: pass
                cd('/')
                manifest['libraries'].append({'name':name,'targets':tgts})
    except: pass

    # JDBC
    try:
        cd('/JDBCSystemResources')
        jdbcs = cmo.getJDBCSystemResources()
        if jdbcs:
            i=0
            while i<len(jdbcs):
                jdbc=jdbcs[i]; i+=1
                jname=jdbc.getName()
                if _skip_jdbc(jname): continue
                jndi=[]; driver=None; url=None; props={}; tgts=[]
                try:
                    cd('/JDBCSystemResources/'+jname+'/JdbcResource/'+jname+'/JDBCDataSourceParams/'+jname)
                    jn=cmo.getJNDINames()
                    if jn:
                        k=0
                        while k<len(jn): jndi.append(jn[k]); k+=1
                except: pass
                try:
                    cd('/JDBCSystemResources/'+jname+'/JdbcResource/'+jname+'/JDBCDriverParams/'+jname)
                    try: driver=_safe_str(cmo.getDriverName())
                    except: driver=None
                    try: url=_safe_str(cmo.getUrl())
                    except: url=None
                    try:
                        pset=cmo.getProperties()
                        if pset:
                            plist=pset.getProperties()
                            if plist:
                                p=0
                                while p<len(plist):
                                    pr=plist[p]; props[pr.getName()]=_safe_str(pr.getValue()); p+=1
                    except: pass
                except: pass
                try:
                    cd('/JDBCSystemResources/'+jname+'/Targets')
                    t=cmo.getTargets()
                    if t:
                        k=0
                        while k<len(t): tgts.append(t[k].getName()); k+=1
                except: pass
                cd('/')
                manifest['jdbc'].append({'name':jname,'jndi':jndi,'driver':driver,'url':url,'props':props,'targets':tgts})
    except: pass

    # JMS
    try:
        cd('/JMSSystemResources')
        mods = cmo.getJMSSystemResources()
        if mods:
            i=0
            while i<len(mods):
                mod=mods[i]; i+=1
                mname=mod.getName()
                if _skip_jms(mname): continue
                module={'name':mname,'targets':[],'connectionFactories':[],'queues':[],'topics':[],'subdeployments':{}}
                try:
                    cd('/JMSSystemResources/'+mname+'/Targets')
                    t=cmo.getTargets()
                    if t:
                        k=0
                        while k<len(t): module['targets'].append(t[k].getName()); k+=1
                except: pass
                try:
                    cd('/JMSSystemResources/'+mname+'/JMSResource/'+mname)
                    cfs=cmo.getConnectionFactories()
                    if cfs:
                        k=0
                        while k<len(cfs):
                            cf=cfs[k]; module['connectionFactories'].append({'name':cf.getName(),'jndi':_safe_str(cf.getJNDIName())}); k+=1
                    qs=cmo.getQueues()
                    if qs:
                        k=0
                        while k<len(qs):
                            q=qs[k]; module['queues'].append({'name':q.getName(),'jndi':_safe_str(q.getJNDIName()),'subdeployment':_safe_str(q.getSubDeploymentName())}); k+=1
                    ts=cmo.getTopics()
                    if ts:
                        k=0
                        while k<len(ts):
                            tpc=ts[k]; module['topics'].append({'name':tpc.getName(),'jndi':_safe_str(tpc.getJNDIName()),'subdeployment':_safe_str(tpc.getSubDeploymentName())}); k+=1
                except: pass
                try:
                    cd('/JMSSystemResources/'+mname+'/SubDeployments')
                    sds=cmo.getSubDeployments()
                    if sds:
                        k=0
                        while k<len(sds):
                            sd=sds[k]; sdname=sd.getName(); targets=[]
                            try:
                                cd('/JMSSystemResources/'+mname+'/SubDeployments/'+sdname+'/Targets')
                                t=cmo.getTargets()
                                if t:
                                    x=0
                                    while x<len(t):
                                        targets.append(t[x].getName()); x+=1
                            except: pass
                            module['subdeployments'][sdname]=targets; k+=1
                except: pass
                cd('/')
                manifest['jms'].append(module)
    except: pass

    # ----------------------- NEW: JCA (adapter connection-instances/JNDIs) ----
    def export_adapter_instances(adapter):
        out={'adapter':adapter,'instances':[]}
        path='/AppDeployments/'+adapter
        try:
            if not ls(path, returnMap='true'):
                return None
            cd(path)
            app=cmo; plan=app.getDeploymentPlan()
            if plan is None:
                cd('/'); return out  # adapter deployed but no plan; nothing to list
            planBean = plan.getPlanBean()
            mos = planBean.getModuleOverrides()
            if mos:
                i=0
                while i<len(mos):
                    mo=mos[i]
                    # match module by name if present; otherwise accept single rar plan
                    if mo.getModuleType()=='rar':
                        if mo.getModuleName() and mo.getModuleName()!=adapter:
                            i+=1; continue
                        cos = mo.getConnectionInstanceOverrides()
                        if cos:
                            j=0
                            while j<len(cos):
                                co=cos[j]
                                jndi=_safe_str(co.getJndiName())
                                if jndi is not None:
                                    out['instances'].append({'jndi':jndi})
                                j+=1
                        break
                    i+=1
            cd('/')
            return out
        except:
            cd('/')
            return out

    a=0
    while a<len(JCA_ADAPTERS):
        ad=JCA_ADAPTERS[a]; a+=1
        res = export_adapter_instances(ad)
        if res and len(res['instances'])>0:
            manifest['jca'].append(res)

    # Save manifest
    manifest_path = os.path.abspath(os.path.join(out_dir_abs, 'manifest-dev-'+ts_file+'.json'))
    write_json(manifest_path, manifest)

    print ''
    print 'Export complete.'
    print '  Manifest:', manifest_path

    disconnect(); exit()

main()


