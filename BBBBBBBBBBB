Script A — export_dev.py (run against DEV Admin)

# =============================================================================
# export_dev.py — WLST-safe export of DEV config to a JSON manifest (+ optional OSB jar)
# Run: $WL_HOME/common/bin/wlst.sh export_dev.py
# =============================================================================

# Avoid features older Jython/WLST may lack:
# - No ternary expressions
# - No "with open(...)"
# - Minimal list comprehensions
# - Try simplejson fallback
try:
    import json
except:
    import simplejson as json

import os
import time

# --- WLST / Java imports ---
from java.lang import String
from javax.management import ObjectName
from jarray import array as jarrayArray

# ---------- USER VARS (EDIT) ----------
ADMIN_URL  = 't3s://dev-admin-host:7002'  # change to your DEV admin URL
ADMIN_USER = 'weblogic'
ADMIN_PASS = '***'

OUT_DIR    = os.path.abspath('./export')
SB_JAR     = None  # will set after OUT_DIR exists (optional OSB export)

# Which JCA adapters to scan for plan variables (adjust to your domain)
JCA_ADAPTERS = ['DbAdapter','FileAdapter','JmsAdapter','AqAdapter','FtpAdapter','SocketAdapter','SapAdapter']

# ---------- Helpers ----------
def ensure_dir(p):
    if not os.path.isdir(p):
        os.makedirs(p)

def safe_str(v):
    if v is None:
        return None
    return str(v)

# ---------- Connect ----------
connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)

# Use domainConfig() for configuration MBeans
domainConfig()

ensure_dir(OUT_DIR)
timestamp = time.strftime('%Y%m%d-%H%M%S')
SB_JAR = os.path.join(OUT_DIR, 'sbconfig-dev-' + timestamp + '.jar')

manifest = {
    'domainVersion': None,
    'exportedAt': time.strftime('%Y-%m-%d %H:%M:%S'),
    'adminUrl': ADMIN_URL,
    'targets': {},
    'applications': [],
    'libraries': [],
    'jdbc': [],
    'jms': [],
    'jca': []
}

# ---------- Domain version ----------
try:
    cd('/')
    manifest['domainVersion'] = safe_str(cmo.getDomainVersion())
except:
    pass

# ---------- Targets (Servers / Clusters) ----------
try:
    cd('/')
    for s in cmo.getServers() or []:
        manifest['targets'][s.getName()] = {'type':'Server'}
    for c in cmo.getClusters() or []:
        manifest['targets'][c.getName()] = {'type':'Cluster'}
except:
    pass

# ---------- Applications & Libraries ----------
try:
    cd('/AppDeployments')
    for app in cmo.getAppDeployments() or []:
        name = app.getName()
        tgts = []
        try:
            cd('/AppDeployments/' + name + '/Targets')
            for t in cmo.getTargets() or []:
                tgts.append(t.getName())
        except:
            pass
        cd('/')
        manifest['applications'].append({'name': name, 'targets': tgts})
except:
    pass

try:
    cd('/Libraries')
    for lib in cmo.getLibraries() or []:
        name = lib.getName()
        tgts = []
        try:
            cd('/Libraries/' + name + '/Targets')
            for t in cmo.getTargets() or []:
                tgts.append(t.getName())
        except:
            pass
        cd('/')
        manifest['libraries'].append({'name': name, 'targets': tgts})
except:
    pass

# ---------- JDBC ----------
try:
    cd('/JDBCSystemResources')
    for jdbc in cmo.getJDBCSystemResources() or []:
        jname = jdbc.getName()

        # JNDI names
        jndi = []
        try:
            cd('/JDBCSystemResources/' + jname + '/JdbcResource/' + jname + '/JDBCDataSourceParams/' + jname)
            jndi = list(cmo.getJNDINames() or [])
        except:
            pass

        # Driver + URL + Properties
        driver = None
        url    = None
        props  = {}
        try:
            cd('/JDBCSystemResources/' + jname + '/JdbcResource/' + jname + '/JDBCDriverParams/' + jname)
            driver = safe_str(cmo.getDriverName())
            url    = safe_str(cmo.getUrl())
            # Properties (username, etc.) — note: password is not readable
            try:
                propSet = cmo.getProperties()
                if propSet is not None:
                    for p in propSet.getProperties() or []:
                        props[p.getName()] = safe_str(p.getValue())
            except:
                pass
        except:
            pass

        # Targets
        tgts = []
        try:
            cd('/JDBCSystemResources/' + jname + '/Targets')
            for t in cmo.getTargets() or []:
                tgts.append(t.getName())
        except:
            pass

        cd('/')
        manifest['jdbc'].append({
            'name': jname, 'jndi': jndi, 'driver': driver, 'url': url, 'props': props, 'targets': tgts
        })
except:
    pass

# ---------- JMS (Modules, CFs, Queues/Topics, Subdeployments) ----------
try:
    cd('/JMSSystemResources')
    for mod in cmo.getJMSSystemResources() or []:
        mname = mod.getName()
        module = {'name': mname, 'targets': [], 'connectionFactories': [], 'queues': [], 'topics': [], 'subdeployments': {}}

        # Module targets
        try:
            cd('/JMSSystemResources/' + mname + '/Targets')
            tg = []
            for t in cmo.getTargets() or []:
                tg.append(t.getName())
            module['targets'] = tg
        except:
            pass

        # CFs / Destinations
        try:
            cd('/JMSSystemResources/' + mname + '/JmsResource/' + mname)
            for cf in cmo.getConnectionFactories() or []:
                module['connectionFactories'].append({'name': cf.getName(), 'jndi': safe_str(cf.getJNDIName())})
            for q in cmo.getQueues() or []:
                module['queues'].append({'name': q.getName(), 'jndi': safe_str(q.getJNDIName()), 'subdeployment': safe_str(q.getSubDeploymentName())})
            for t in cmo.getTopics() or []:
                module['topics'].append({'name': t.getName(), 'jndi': safe_str(t.getJNDIName()), 'subdeployment': safe_str(t.getSubDeploymentName())})
        except:
            pass

        # Subdeployments
        try:
            cd('/JMSSystemResources/' + mname + '/SubDeployments')
            for sd in cmo.getSubDeployments() or []:
                sdname = sd.getName()
                targets = []
                try:
                    cd('/JMSSystemResources/' + mname + '/SubDeployments/' + sdname + '/Targets')
                    for t in cmo.getTargets() or []:
                        targets.append(t.getName())
                except:
                    pass
                module['subdeployments'][sdname] = targets
        except:
            pass

        manifest['jms'].append(module)
        cd('/')
except:
    pass

# ---------- JCA Outbound Plan Variables (read from AppDeployments) ----------
def scrape_adapter_ocps(adapter):
    ocps = []
    path = '/AppDeployments/' + adapter
    try:
        if ls(path, returnMap='true'):
            cd(path)
            app = cmo
            plan = app.getDeploymentPlan()
            if plan is not None:
                planBean = plan.getPlanBean()
                for var in planBean.getVariables() or []:
                    vname = var.getName()
                    # Heuristic: outbound/OCP-ish
                    if ('ConnectionFactory' in vname) or ('ConnectionInstance' in vname) or ('Outbound' in vname):
                        val = safe_str(var.getValue())
                        entries = []
                        for ass in var.getVariableAssignments() or []:
                            try:
                                targetName = ass.getTarget().getName()
                            except:
                                targetName = None
                            entries.append({'target': safe_str(targetName), 'planPath': safe_str(ass.getPlanPath())})
                        ocps.append({'variable': vname, 'value': val, 'assignments': entries})
            cd('/')
    except:
        cd('/')
    return ocps

for ad in JCA_ADAPTERS:
    ocp_list = scrape_adapter_ocps(ad)
    if ocp_list and len(ocp_list) > 0:
        manifest['jca'].append({'adapter': ad, 'ocps': ocp_list})

# ---------- Optional: OSB export (all) ----------
# Works only if running OSB-enabled WLST; otherwise silently skips
try:
    from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
    alsb = findService(ALSBConfigurationMBean.NAME, ALSBConfigurationMBean.TYPE)
    if alsb is not None:
        print 'Exporting OSB config to: ' + SB_JAR
        # Export everything (null scope)
        alsb.exportToJar(SB_JAR, None, True, None)
except:
    print 'OSB export skipped (ALSB MBean not available).'

# ---------- Save manifest ----------
MANIFEST = os.path.join(OUT_DIR, 'manifest-dev-' + timestamp + '.json')
data = json.dumps(manifest, indent=2, sort_keys=True)

f = open(MANIFEST, 'w')
try:
    f.write(data)
finally:
    f.close()

print ''
print 'Export complete.'
print '  Manifest: ' + MANIFEST
if SB_JAR and os.path.exists(SB_JAR):
    print '  OSB jar : ' + SB_JAR

disconnect()
exit()


