# =============================================================================
# import_local.py — Apply manifest (JDBC, JMS) to local WLS with verbose logging
# Usage: C:\DevTools\Jdev\oracle_common\common\bin\wlst.cmd .\import_local.py
# =============================================================================

# --- USER SETTINGS -----------------------------------------------------------
ADMIN_URL   = 't3://localhost:7101'      # JDeveloper Integrated default
ADMIN_USER  = 'weblogic'
ADMIN_PASS  = '***'

MANIFEST    = r'.\export\manifest-dev-YYYYMMDD-HHMMSS.json'   # <-- set exact file path
SB_JAR      = r'.\export\sbconfig-dev-YYYYMMDD-HHMMSS.jar'    # <-- optional (OSB)

FALLBACK_SERVER = 'DefaultServer'  # if dev targets don't exist locally

# --- IMPORTS ----------------------------------------------------------------
import os
from javax.management import ObjectName
from datetime import datetime

# --- Pretty logging ----------------------------------------------------------
def stamp(): return datetime.now().strftime('%H:%M:%S')
def log(msg):     print '[%s] %s' % (stamp(), msg)
def ok(msg='OK'): print '[%s]   ✅ %s' % (stamp(), msg)
def warn(msg):    print '[%s]   ⚠️  %s' % (stamp(), msg)
def err(msg):     print '[%s]   ❌ %s' % (stamp(), msg)
def step(msg):    print '\n[%s] ▶ %s' % (stamp(), msg)

# --- tiny JSON loader (works on old Jython) ---------------------------------
def _parse_json_text(txt):
    try:
        import json
        return json.loads(txt)
    except:
        try:
            import simplejson as json
            return json.loads(txt)
        except:
            rep = txt.replace('true','True').replace('false','False').replace('null','None')
            return eval(rep, {"__builtins__": {}})

def _load_manifest(path):
    fr = open(path, 'r')
    try:
        return _parse_json_text(fr.read())
    finally:
        fr.close()

# --- WLST helpers ------------------------------------------------------------
def _pwd():
    try:
        return pwd()
    except:
        return '(unknown)'

def _ensure_edit():
    # Start or reuse an edit session
    try:
        edit()
        startEdit(waitTimeInMillis=600000)  # 10 min
        return True
    except:
        # Already in edit — WLST prints a message; we still return True
        return True

def _activate():
    try:
        save(); activate(block='true')
        ok('Changes activated')
        return True
    except:
        err('Activation failed')
        return False

def _get_servers():
    cd('/Servers')
    L=[]; xs=cmo.getServers()
    if xs:
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _get_clusters():
    cd('/Clusters')
    L=[]; xs=cmo.getClusters()
    if xs:
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _map_targets(dev_names):
    servers=_get_servers(); clusters=_get_clusters()
    objs=[]
    for n in (dev_names or []):
        if n in servers:
            objs.append(ObjectName('com.bea:Name='+n+',Type=Server'))
        elif n in clusters:
            objs.append(ObjectName('com.bea:Name='+n+',Type=Cluster'))
    if len(objs)==0:
        if FALLBACK_SERVER in servers:
            objs=[ObjectName('com.bea:Name='+FALLBACK_SERVER+',Type=Server')]
        elif len(servers)>0:
            objs=[ObjectName('com.bea:Name='+servers[0]+',Type=Server')]
    return objs

# --- JDBC --------------------------------------------------------------------
def ensure_jdbc(ds, results):
    name=ds.get('name'); jndi=ds.get('jndi') or []; url=ds.get('url'); driver=ds.get('driver'); props=ds.get('props') or {}
    step('JDBC: %s' % name)
    try:
        cd('/')
        if ls('/JDBCSystemResources/'+name, returnMap='true'):
            ok('(exists) JDBCSystemResource/%s' % name)
            results['jdbc_exists'].append(name)
            return

        _ensure_edit()
        cmo.createJDBCSystemResource(name)
        ok('Created JDBCSystemResource/%s' % name)

        # JNDI
        try:
            path = '/JDBCSystemResources/%s/JdbcResource/%s/JDBCDataSourceParams/%s' % (name, name, name)
            cd(path); log('cd: %s' % _pwd())
            from jarray import array as jarrayArray
            from java.lang import String
            set('JNDINames', jarrayArray(jndi, String))
            ok('Set JNDINames = %s' % (jndi,))
        except:
            warn('Unable to set JNDINames at %s' % path)

        # Driver/URL + Properties
        try:
            path = '/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s' % (name, name, name)
            cd(path); log('cd: %s' % _pwd())
            if driver: cmo.setDriverName(driver); ok('DriverName=%s' % driver)
            if url:    cmo.setUrl(url);           ok('URL=%s' % url)
            try:
                cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s/Properties/%s' % (name, name, name, name))
                for k in props.keys():
                    if not ls('Properties/'+k, returnMap='true'): cmo.createProperty(k)
                    cd('Properties/'+k); cmo.setValue(props[k]); cd('..')
                ok('Driver properties set: %s' % (props.keys(),))
            except:
                warn('No driver properties set')
        except:
            warn('Could not set Driver/URL for %s' % name)

        # Targets
        try:
            path = '/JDBCSystemResources/%s' % name
            cd(path); log('cd: %s' % _pwd())
            from jarray import array as jarrayArray
            mapped = _map_targets(ds.get('targets'))
            set('Targets', jarrayArray(mapped, ObjectName))
            ok('Targets mapped: %s' % (mapped,))
        except:
            warn('Could not set Targets for %s (pwd=%s)' % (name, _pwd()))

        if _activate():
            results['jdbc_ok'].append(name)
        else:
            results['jdbc_fail'].append(name)
    except:
        err('JDBC failed: %s (pwd=%s)' % (name, _pwd()))
        results['jdbc_fail'].append(name)

# --- JMS ---------------------------------------------------------------------
def ensure_jms_module(mod, results):
    mname=mod.get('name')
    step('JMS Module: %s' % mname)
    try:
        cd('/')
        if not ls('/JMSSystemResources/'+mname, returnMap='true'):
            _ensure_edit()
            cmo.createJMSSystemResource(mname)
            ok('Created JMSSystemResource/%s' % mname)
            try:
                cd('/JMSSystemResources/'+mname); log('cd: %s' % _pwd())
                from jarray import array as jarrayArray
                set('Targets', jarrayArray(_map_targets(mod.get('targets')), ObjectName))
                ok('Module targets set')
            except:
                warn('Could not set module targets (pwd=%s)' % _pwd())
            _activate()
        else:
            ok('(exists) JMSSystemResource/%s' % mname)

        # Subdeployments
        subs = mod.get('subdeployments') or {}
        if len(subs)>0:
            _ensure_edit()
            try:
                cd('/JMSSystemResources/'+mname); log('cd: %s' % _pwd())
                for sd in subs.keys():
                    if not ls('SubDeployments/'+sd, returnMap='true'):
                        cmo.createSubDeployment(sd); ok('Created SubDeployment/%s' % sd)
                    cd('SubDeployments/'+sd); log('cd: %s' % _pwd())
                    from jarray import array as jarrayArray
                    set('Targets', jarrayArray(_map_targets(subs[sd]), ObjectName))
                    ok('SubDeployment %s targets set' % sd)
                    cd('..')
            except:
                warn('Could not create/target subdeployments (pwd=%s)' % _pwd())
            _activate()

        # Ensure JMSResource exists (case sensitive: **JMSResource**)
        try:
            path = '/JMSSystemResources/%s/JMSResource/%s' % (mname, mname)
            cd(path); log('cd: %s' % _pwd())
        except:
            _ensure_edit()
            try:
                cd('/JMSSystemResources/'+mname)
                cmo.createJmsResource(mname)  # creates child bean
                ok('Created JMSResource/%s' % mname)
                _activate()
            except:
                warn('Could not create JMSResource (pwd=%s)' % _pwd())

        # Create CFs / Queues / Topics (your manifest currently has none)
        # ConnectionFactories
        try:
            cd('/JMSSystemResources/%s/JMSResource/%s' % (mname, mname)); log('cd: %s' % _pwd())
            for cf in mod.get('connectionFactories', []):
                nm=cf.get('name'); jndi=cf.get('jndi')
                if not ls('ConnectionFactories/'+nm, returnMap='true'):
                    _ensure_edit()
                    cmo.createConnectionFactory(nm)
                    cd('ConnectionFactories/'+nm)
                    if jndi: cmo.setJNDIName(jndi)
                    ok('Created CF %s (JNDI=%s)' % (nm, jndi))
                    _activate()
                else:
                    ok('(exists) CF %s' % nm)
        except:
            warn('CF pass failed for %s' % mname)

        # Queues
        try:
            cd('/JMSSystemResources/%s/JMSResource/%s' % (mname, mname)); log('cd: %s' % _pwd())
            for q in mod.get('queues', []):
                nm=q.get('name'); jndi=q.get('jndi'); sd=q.get('subdeployment')
                if not ls('Queues/'+nm, returnMap='true'):
                    _ensure_edit()
                    cmo.createQueue(nm)
                    cd('Queues/'+nm)
                    if jndi: cmo.setJNDIName(jndi)
                    if sd:   cmo.setSubDeploymentName(sd)
                    ok('Created Queue %s (JNDI=%s, SD=%s)' % (nm, jndi, sd))
                    _activate()
                else:
                    ok('(exists) Queue %s' % nm)
        except:
            warn('Queue pass failed for %s' % mname)

        # Topics
        try:
            cd('/JMSSystemResources/%s/JMSResource/%s' % (mname, mname)); log('cd: %s' % _pwd())
            for t in mod.get('topics', []):
                nm=t.get('name'); jndi=t.get('jndi'); sd=t.get('subdeployment')
                if not ls('Topics/'+nm, returnMap='true'):
                    _ensure_edit()
                    cmo.createTopic(nm)
                    cd('Topics/'+nm)
                    if jndi: cmo.setJNDIName(jndi)
                    if sd:   cmo.setSubDeploymentName(sd)
                    ok('Created Topic %s (JNDI=%s, SD=%s)' % (nm, jndi, sd))
                    _activate()
                else:
                    ok('(exists) Topic %s' % nm)
        except:
            warn('Topic pass failed for %s' % mname)

        results['jms_ok'].append(mname)
    except:
        err('JMS module failed: %s (pwd=%s)' % (mname, _pwd()))
        results['jms_fail'].append(mname)

# --- OSB (optional) ----------------------------------------------------------
def import_osb_if_any(path_jar, results):
    step('OSB import (optional)')
    if not (path_jar and os.path.exists(path_jar)):
        warn('OSB jar not found -> skip')
        results['osb'] = 'skipped (jar missing)'
        return
    try:
        from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
        alsb = findService(ALSBConfigurationMBean.NAME, ALSBConfigurationMBean.TYPE)
        if alsb is None:
            warn('ALSB MBean not available -> skip')
            results['osb'] = 'skipped (ALSB MBean not available)'
            return
        try:
            alsb.importToDomain(path_jar, True)
            ok('OSB import attempted via importToDomain')
            results['osb'] = 'attempted'
        except:
            warn('importToDomain not supported; skipping')
            results['osb'] = 'skipped (method unsupported)'
    except:
        warn('OSB APIs not present; skipping')
        results['osb'] = 'skipped (APIs not present)'

# --- run ---------------------------------------------------------------------
def main():
    step('Connect to Admin')
    connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
    ok('Connected to %s' % ADMIN_URL)
    domainConfig()
    ok('In domainConfig tree')

    man = _load_manifest(MANIFEST)
    results = {
        'jdbc_ok': [], 'jdbc_fail': [], 'jdbc_exists': [],
        'jms_ok': [],  'jms_fail': [],
        'osb': None
    }

    # JDBC
    for ds in man.get('jdbc', []):
        ensure_jdbc(ds, results)

    # JMS
    for mod in man.get('jms', []):
        ensure_jms_module(mod, results)

    # OSB
    import_osb_if_any(SB_JAR, results)

    # Summary
    step('RESULT SUMMARY')
    print 'JDBC created   :', results['jdbc_ok']
    print 'JDBC existed   :', results['jdbc_exists']
    print 'JDBC failed    :', results['jdbc_fail']
    print 'JMS ok         :', results['jms_ok']
    print 'JMS failed     :', results['jms_fail']
    print 'OSB            :', results['osb']

    disconnect(); ok('Disconnected')
    exit()

main()


