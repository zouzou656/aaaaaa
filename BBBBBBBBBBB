Here’s a WLST/Jython-safe export_dev.py you can drop in and run.
It avoids time, with open, and Python ternaries; it writes valid JSON even if the json module is missing; and it filters out WebLogic/Oracle system noise so you only capture the deployables you likely care about.

# =============================================================================
# export_dev.py — WLST-safe export of DEV config to a clean JSON manifest
# Usage: $WL_HOME/common/bin/wlst.sh export_dev.py
# Notes:
#   - Works with WLS/OSB 12c WLST (older Jython).
#   - No "with open", no ternaries, no reliance on Python "time".
#   - Writes valid JSON via built-in writer (no json/simplejson dependency).
#   - Filters out system apps/libs/JDBC/JMS (edit the *_EXCLUDE_* lists below).
#   - OSB export is optional and auto-skips if ALSB MBean isn’t available.
# =============================================================================

# ----------------------- USER SETTINGS ---------------------------------------
ADMIN_URL  = 't3s://dev-admin-host:7002'   # <-- change to your DEV admin
ADMIN_USER = 'weblogic'                    # <-- change
ADMIN_PASS = '***'                         # <-- change

OUT_DIR    = './export'                    # output directory (created if absent)

# JCA adapters to scrape plan variables from (deployment plan values)
JCA_ADAPTERS = [
  'DbAdapter', 'FileAdapter', 'JmsAdapter', 'AqAdapter',
  'FtpAdapter', 'SocketAdapter', 'SapAdapter'
]

# ----------------------- IMPORTS / RUNTIME -----------------------------------
import os
from datetime import datetime

# Java types referenced by WLST operations
from javax.management import ObjectName

# ----------------------- MINIMAL JSON WRITER ---------------------------------
# (No dependency on json/simplejson; always produces valid JSON)

def _json_escape(s):
    if s is None:
        return 'null'
    s = str(s)
    out = []
    i = 0
    while i < len(s):
        ch = s[i]
        code = ord(ch)
        if ch == '"':
            out.append('\\"')
        elif ch == '\\':
            out.append('\\\\')
        elif ch == '\b':
            out.append('\\b')
        elif ch == '\f':
            out.append('\\f')
        elif ch == '\n':
            out.append('\\n')
        elif ch == '\r':
            out.append('\\r')
        elif ch == '\t':
            out.append('\\t')
        elif code < 0x20 or code == 0x2028 or code == 0x2029:
            out.append('\\u%04x' % code)
        else:
            out.append(ch)
        i += 1
    return '"' + ''.join(out) + '"'

def _to_json(o):
    # Handle None / booleans
    if o is None:
        return 'null'
    tname = str(type(o))
    # Booleans
    try:
        # Jython booleans appear as <type 'bool'>
        if o is True:
            return 'true'
        if o is False:
            return 'false'
    except:
        pass
    # Numbers
    if tname.find("int") != -1 or tname.find("long") != -1 or tname.find("float") != -1 or tname.find("double") != -1:
        return str(o)
    # Strings
    if tname.find("str") != -1 or tname.find("unicode") != -1 or tname.find("java.lang.String") != -1:
        return _json_escape(o)
    # Lists / Tuples
    if isinstance(o, list) or isinstance(o, tuple):
        parts = []
        idx = 0
        while idx < len(o):
            parts.append(_to_json(o[idx]))
            idx += 1
        return '[' + ','.join(parts) + ']'
    # Dicts
    if isinstance(o, dict):
        parts = []
        for k in o.keys():
            parts.append(_json_escape(k) + ':' + _to_json(o[k]))
        return '{' + ','.join(parts) + '}'
    # Fallback
    return _json_escape(str(o))

def write_json(path, obj):
    # Ensure directory
    d = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(d):
        os.makedirs(d)
    fw = open(path, 'w')
    try:
        fw.write(_to_json(obj))
    finally:
        fw.close()

# ----------------------- FILTERS (tune as needed) ----------------------------
_EXCLUDE_APP_PREFIX = (
  'em', 'wsm-pm', 'wsm-cache', 'dms', 'DMS', 'coherence', 'weblogic',
  'opss', 'oracle.bi', 'oracle.dms', 'oracledi', 'soa-infra', 'mft',
  'bpm', 'adminconsole', 'bea_wls9_async_response', 'ums', 'wls-wsat'
)
_EXCLUDE_APP_CONTAINS = ('#', 'coherence-transaction', '-rar', 'management', 'wlfullclient')

_EXCLUDE_JDBC_PREFIX = (
  'SOADataSource','EDNDataSource','EDNLocalTxDataSource','OraSDPMDataSource',
  'mds-','opss-','wlsbjmsrp','WLSSchemaDataSource','LocalSvcTblDataSource',
  'SOALocalTxDataSource','SOA_MDS','FMwDT','FMWDT','Audit','bam','mds-owsm',
  'SOAINFRA','ESSDS','UmsDataSource','RSMANAGEDDS','STBDataSource'
)

_EXCLUDE_JMS_PREFIX = (
  'UMSJMSServer','UMSJMSSystemResource','SOAJMSModule','EDN',
  'BPM','wlsbJMSServer','WseeJmsModule','WLSJMSModule'
)

def _skip_app(name):
    if name is None:
        return True
    low = name.lower()
    # startswith filters
    i = 0
    while i < len(_EXCLUDE_APP_PREFIX):
        p = _EXCLUDE_APP_PREFIX[i]
        if low.startswith(p):
            return True
        i += 1
    # contains filters
    j = 0
    while j < len(_EXCLUDE_APP_CONTAINS):
        c = _EXCLUDE_APP_CONTAINS[j]
        if low.find(c.lower()) != -1:
            return True
        j += 1
    return False

def _skip_jdbc(name):
    if name is None:
        return True
    low = name.lower()
    i = 0
    while i < len(_EXCLUDE_JDBC_PREFIX):
        p = _EXCLUDE_JDBC_PREFIX[i]
        if low.startswith(p.lower()):
            return True
        i += 1
    return False

def _skip_jms(name):
    if name is None:
        return True
    low = name.lower()
    i = 0
    while i < len(_EXCLUDE_JMS_PREFIX):
        p = _EXCLUDE_JMS_PREFIX[i]
        if low.startswith(p.lower()):
            return True
        i += 1
    return False

def _safe_str(v):
    if v is None:
        return None
    return str(v)

# ----------------------- START EXPORT ----------------------------------------
def main():
    # Connect & enter config tree
    connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
    domainConfig()

    # Prepare paths & manifest
    ts_file = datetime.now().strftime('%Y%m%d-%H%M%S')
    ts_hum  = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    out_dir_abs = os.path.abspath(OUT_DIR)
    if not os.path.isdir(out_dir_abs):
        os.makedirs(out_dir_abs)

    manifest = {
        'domainVersion': None,
        'exportedAt': ts_hum,
        'adminUrl': ADMIN_URL,
        'targets': {},
        'applications': [],
        'libraries': [],
        'jdbc': [],
        'jms': [],
        'jca': []
    }

    # Domain version
    try:
        cd('/')
        manifest['domainVersion'] = _safe_str(cmo.getDomainVersion())
    except:
        manifest['domainVersion'] = None

    # Targets (Servers/Clusters)
    try:
        cd('/')
        srvs = cmo.getServers()
        if srvs is not None:
            idx = 0
            while idx < len(srvs):
                s = srvs[idx]
                manifest['targets'][s.getName()] = { 'type': 'Server' }
                idx += 1
        cls = cmo.getClusters()
        if cls is not None:
            j = 0
            while j < len(cls):
                c = cls[j]
                manifest['targets'][c.getName()] = { 'type': 'Cluster' }
                j += 1
    except:
        pass

    # Applications
    try:
        cd('/AppDeployments')
        apps = cmo.getAppDeployments()
        if apps is not None:
            i = 0
            while i < len(apps):
                app = apps[i]
                name = app.getName()
                i += 1
                if _skip_app(name):
                    continue
                tgts = []
                try:
                    cd('/AppDeployments/' + name + '/Targets')
                    tlist = cmo.getTargets()
                    if tlist is not None:
                        k = 0
                        while k < len(tlist):
                            tgts.append(tlist[k].getName())
                            k += 1
                except:
                    pass
                cd('/')
                entry = {'name': name, 'targets': tgts}
                manifest['applications'].append(entry)
    except:
        pass

    # Libraries
    try:
        cd('/Libraries')
        libs = cmo.getLibraries()
        if libs is not None:
            i = 0
            while i < len(libs):
                lib = libs[i]
                name = lib.getName()
                i += 1
                if _skip_app(name):
                    continue
                tgts = []
                try:
                    cd('/Libraries/' + name + '/Targets')
                    tlist = cmo.getTargets()
                    if tlist is not None:
                        k = 0
                        while k < len(tlist):
                            tgts.append(tlist[k].getName())
                            k += 1
                except:
                    pass
                cd('/')
                entry = {'name': name, 'targets': tgts}
                manifest['libraries'].append(entry)
    except:
        pass

    # JDBC
    try:
        cd('/JDBCSystemResources')
        jdbcs = cmo.getJDBCSystemResources()
        if jdbcs is not None:
            i = 0
            while i < len(jdbcs):
                jdbc = jdbcs[i]
                i += 1
                jname = jdbc.getName()
                if _skip_jdbc(jname):
                    continue

                jndi = []
                try:
                    cd('/JDBCSystemResources/' + jname + '/JdbcResource/' + jname + '/JDBCDataSourceParams/' + jname)
                    jnames = cmo.getJNDINames()
                    if jnames is not None:
                        k = 0
                        while k < len(jnames):
                            jndi.append(jnames[k])
                            k += 1
                except:
                    pass

                driver = None
                url = None
                props = {}
                try:
                    cd('/JDBCSystemResources/' + jname + '/JdbcResource/' + jname + '/JDBCDriverParams/' + jname)
                    try:
                        driver = _safe_str(cmo.getDriverName())
                    except:
                        driver = None
                    try:
                        url = _safe_str(cmo.getUrl())
                    except:
                        url = None
                    # properties (username etc.; password not readable)
                    try:
                        pset = cmo.getProperties()
                        if pset is not None:
                            plist = pset.getProperties()
                            if plist is not None:
                                p = 0
                                while p < len(plist):
                                    pr = plist[p]
                                    props[pr.getName()] = _safe_str(pr.getValue())
                                    p += 1
                    except:
                        pass
                except:
                    pass

                tgts = []
                try:
                    cd('/JDBCSystemResources/' + jname + '/Targets')
                    tlist = cmo.getTargets()
                    if tlist is not None:
                        k = 0
                        while k < len(tlist):
                            tgts.append(tlist[k].getName())
                            k += 1
                except:
                    pass

                cd('/')
                entry = {
                  'name': jname, 'jndi': jndi, 'driver': driver, 'url': url,
                  'props': props, 'targets': tgts
                }
                manifest['jdbc'].append(entry)
    except:
        pass

    # JMS (modules, CFs, queues/topics, subdeployments)
    try:
        cd('/JMSSystemResources')
        mods = cmo.getJMSSystemResources()
        if mods is not None:
            i = 0
            while i < len(mods):
                mod = mods[i]
                i += 1
                mname = mod.getName()
                if _skip_jms(mname):
                    continue

                module = {
                  'name': mname,
                  'targets': [],
                  'connectionFactories': [],
                  'queues': [],
                  'topics': [],
                  'subdeployments': {}
                }

                # module targets
                try:
                    cd('/JMSSystemResources/' + mname + '/Targets')
                    tlist = cmo.getTargets()
                    if tlist is not None:
                        k = 0
                        while k < len(tlist):
                            module['targets'].append(tlist[k].getName())
                            k += 1
                except:
                    pass

                # CFs, Queues, Topics
                try:
                    cd('/JMSSystemResources/' + mname + '/JmsResource/' + mname)
                    cfs = cmo.getConnectionFactories()
                    if cfs is not None:
                        k = 0
                        while k < len(cfs):
                            cf = cfs[k]
                            module['connectionFactories'].append({
                              'name': cf.getName(), 'jndi': _safe_str(cf.getJNDIName())
                            })
                            k += 1
                    qs = cmo.getQueues()
                    if qs is not None:
                        k = 0
                        while k < len(qs):
                            q = qs[k]
                            module['queues'].append({
                              'name': q.getName(),
                              'jndi': _safe_str(q.getJNDIName()),
                              'subdeployment': _safe_str(q.getSubDeploymentName())
                            })
                            k += 1
                    tps = cmo.getTopics()
                    if tps is not None:
                        k = 0
                        while k < len(tps):
                            t = tps[k]
                            module['topics'].append({
                              'name': t.getName(),
                              'jndi': _safe_str(t.getJNDIName()),
                              'subdeployment': _safe_str(t.getSubDeploymentName())
                            })
                            k += 1
                except:
                    pass

                # Subdeployments
                try:
                    cd('/JMSSystemResources/' + mname + '/SubDeployments')
                    sds = cmo.getSubDeployments()
                    if sds is not None:
                        k = 0
                        while k < len(sds):
                            sd = sds[k]
                            sdname = sd.getName()
                            targets = []
                            try:
                                cd('/JMSSystemResources/' + mname + '/SubDeployments/' + sdname + '/Targets')
                                tlist = cmo.getTargets()
                                if tlist is not None:
                                    x = 0
                                    while x < len(tlist):
                                        targets.append(tlist[x].getName())
                                        x += 1
                            except:
                                pass
                            module['subdeployments'][sdname] = targets
                            k += 1
                except:
                    pass

                manifest['jms'].append(module)
                cd('/')
    except:
        pass

    # JCA Deployment Plan Variables
    def scrape_adapter_ocps(adapter):
        ocps = []
        path = '/AppDeployments/' + adapter
        try:
            if ls(path, returnMap='true'):
                cd(path)
                app = cmo
                plan = app.getDeploymentPlan()
                if plan is not None:
                    planBean = plan.getPlanBean()
                    vars = planBean.getVariables()
                    if vars is not None:
                        i2 = 0
                        while i2 < len(vars):
                            var = vars[i2]
                            vname = var.getName()
                            val = _safe_str(var.getValue())
                            # Heuristic: outbound pool-ish variables
                            hit = 0
                            if vname is not None:
                                vlow = vname.lower()
                                if vlow.find('connectionfactory') != -1 or vlow.find('connectioninstance') != -1 or vlow.find('outbound') != -1:
                                    hit = 1
                            if hit == 1:
                                entries = []
                                assigns = var.getVariableAssignments()
                                if assigns is not None:
                                    j2 = 0
                                    while j2 < len(assigns):
                                        ass = assigns[j2]
                                        tname = None
                                        try:
                                            tname = ass.getTarget().getName()
                                        except:
                                            tname = None
                                        entries.append({'target': _safe_str(tname), 'planPath': _safe_str(ass.getPlanPath())})
                                        j2 += 1
                                ocps.append({'variable': vname, 'value': val, 'assignments': entries})
                            i2 += 1
                cd('/')
        except:
            cd('/')
        return ocps

    a = 0
    while a < len(JCA_ADAPTERS):
        ad = JCA_ADAPTERS[a]
        a += 1
        ocp_list = scrape_adapter_ocps(ad)
        if ocp_list is not None and len(ocp_list) > 0:
            manifest['jca'].append({'adapter': ad, 'ocps': ocp_list})

    # Optional: OSB export (skip quietly if not available)
    sb_jar = os.path.abspath(os.path.join(out_dir_abs, 'sbconfig-dev-' + ts_file + '.jar'))
    try:
        from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
        alsb = findService(ALSBConfigurationMBean.NAME, ALSBConfigurationMBean.TYPE)
        if alsb is not None:
            print 'Exporting OSB configuration to: ' + sb_jar
            try:
                # 12c variant (some environments)
                alsb.exportToJar(sb_jar, None, True, None)
            except:
                try:
                    # Fallback API (older WLSTs)
                    alsb.exportAllToJar(sb_jar)
                except:
                    print '  OSB export method not available; skipping.'
        else:
            print 'ALSB MBean not available; skipping OSB export.'
    except:
        print 'OSB export skipped.'

    # Save manifest (valid JSON)
    manifest_path = os.path.abspath(os.path.join(out_dir_abs, 'manifest-dev-' + ts_file + '.json'))
    write_json(manifest_path, manifest)

    print ''
    print 'Export complete.'
    print '  Manifest: ' + manifest_path
    if os.path.exists(sb_jar):
        print '  OSB jar : ' + sb_jar

    disconnect()
    exit()

# ----------------------- ENTRY POINT -----------------------------------------
main()

What you get
	•	A valid JSON file (no … truncation) at export/manifest-dev-YYYYMMDD-HHMMSS.json.
	•	Only non-system deployments/JDBC/JMS (tune the filter lists if you need more/less).
	•	Optional sbconfig-dev-*.jar if OSB MBeans are present; otherwise it skips gracefully.

