Got it. Below is a practical 2-step WLST approach to “mirror” your Dev Admin domain into your local Integrated WebLogic (JDeveloper) domain:
	•	Script A – export_dev.py: connects to Dev Admin and exports a compact JSON manifest of JDBC/JMS/JCA + targets, and an OSB sbconfig.jar.
	•	Script B – import_local.py: connects to local Integrated WLS and applies anything missing (creates JDBC/JMS, sets adapter OCPs, imports OSB sbconfig.jar, deploys libraries if needed).

Tested style: WLST (Jython), works with WLS/OSB 12c. Adjust URLs, credentials, and adapter names as needed.

⸻

Script A — export_dev.py (run against DEV)

# ============================================================================
# export_dev.py  — Run with: ${WL_HOME}/common/bin/wlst.sh export_dev.py
# Exports: JDBC, JMS, JCA Adapter OCPs, App/Libraries/Targets (to manifest.json)
#          and OSB configuration (sbconfig.jar)
# Requires: OSB WLST classpath (run wlst.sh from OSB home) for ALSB mbeans.
# ============================================================================

import json, os, time

# ---------- USER VARS ----------
ADMIN_URL   = 't3s://dev-admin-host:7002'   # change
ADMIN_USER  = 'weblogic'
ADMIN_PASS  = '***'

OUT_DIR     = os.path.abspath('./export')   # output folder
SB_JAR      = os.path.join(OUT_DIR, 'sbconfig-dev-%s.jar' % time.strftime('%Y%m%d-%H%M%S'))

# Adapters to scrape (add/remove as needed)
JCA_ADAPTERS = [
  'DbAdapter', 'FileAdapter', 'JmsAdapter', 'AqAdapter',
  'FtpAdapter', 'SocketAdapter', 'SapAdapter'
]

# ---------- Helpers ----------
def ensure_dir(p):
    if not os.path.isdir(p):
        os.makedirs(p)

def safe(v):
    return None if v is None else str(v)

# ---------- Connect ----------
connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
domainRuntime()

ensure_dir(OUT_DIR)
manifest = {
  'domainVersion': cmo.getDomainVersion(),
  'exportedAt': time.strftime('%Y-%m-%d %H:%M:%S'),
  'adminUrl': ADMIN_URL,
  'targets': {},
  'applications': [],
  'libraries': [],
  'jdbc': [],
  'jms': [],
  'jca': []
}

# ---------- Targets (servers/clusters) ----------
cd('/DomainRuntime/DomainConfiguration')
for s in cmo.getServers():
    manifest['targets'][s.getName()] = {'type': 'Server'}
for c in cmo.getClusters():
    manifest['targets'][c.getName()] = {'type': 'Cluster'}

# ---------- Applications & Libraries ----------
cd('/AppDeployments')
for app in cmo.getAppDeployments() or []:
    name = app.getName()
    cd('/AppDeployments/%s/Targets' % name)
    tgts = [t.getName() for t in cmo.getTargets() or []]
    cd('/')
    manifest['applications'].append({'name': name, 'targets': tgts})

cd('/Libraries')
for lib in cmo.getLibraries() or []:
    name = lib.getName()
    cd('/Libraries/%s/Targets' % name)
    tgts = [t.getName() for t in cmo.getTargets() or []]
    cd('/')
    manifest['libraries'].append({'name': name, 'targets': tgts})

# ---------- JDBC ----------
cd('/JDBCSystemResources')
for jdbc in cmo.getJDBCSystemResources() or []:
    jname = jdbc.getName()
    cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDataSourceParams/%s' % (jname, jname, jname))
    jndi = list(cmo.getJNDINames() or [])
    cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s' % (jname, jname, jname))
    driver = safe(cmo.getDriverName())
    url    = safe(cmo.getUrl())
    props  = {}
    for p in cmo.getProperties().getProperties() or []:
        props[p.getName()] = safe(p.getValue())
    cd('/JDBCSystemResources/%s/Targets' % jname)
    tgts = [t.getName() for t in cmo.getTargets() or []]
    cd('/')
    manifest['jdbc'].append({
      'name': jname, 'jndi': jndi, 'driver': driver, 'url': url, 'props': props, 'targets': tgts
    })

# ---------- JMS (modules, CFs, queues/topics, filestores, subdeployments) ----------
cd('/JMSSystemResources')
for mod in cmo.getJMSSystemResources() or []:
    mname = mod.getName()
    module = {'name': mname, 'targets': [], 'connectionFactories': [], 'queues': [], 'topics': [], 'subdeployments': {}}
    cd('/JMSSystemResources/%s/Targets' % mname)
    module['targets'] = [t.getName() for t in cmo.getTargets() or []]

    cd('/JMSSystemResources/%s/JmsResource/%s' % (mname, mname))
    for cf in cmo.getConnectionFactories() or []:
        module['connectionFactories'].append({'name': cf.getName(), 'jndi': safe(cf.getJNDIName())})

    for q in cmo.getQueues() or []:
        module['queues'].append({'name': q.getName(), 'jndi': safe(q.getJNDIName()), 'subdeployment': safe(q.getSubDeploymentName())})
    for t in cmo.getTopics() or []:
        module['topics'].append({'name': t.getName(), 'jndi': safe(t.getJNDIName()), 'subdeployment': safe(t.getSubDeploymentName())})

    cd('/JMSSystemResources/%s/SubDeployments' % mname)
    for sd in cmo.getSubDeployments() or []:
        sdname = sd.getName()
        cd('/JMSSystemResources/%s/SubDeployments/%s/Targets' % (mname, sdname))
        module['subdeployments'][sdname] = [t.getName() for t in cmo.getTargets() or []]
        cd('/')

    manifest['jms'].append(module)
    cd('/')

# ---------- JCA Outbound Connection Pools ----------
# Reads Deployment MBeans for each adapter and scrapes plan-based OCPs
def scrape_adapter_ocps(adapter):
    ocps = []
    depPath = '/Deployments/%s' % adapter
    if not ls(depPath, returnMap='true'):
        return ocps
    cd(depPath)
    try:
        app = cmo
        plan = app.getDeploymentPlan()
        if plan is None:
            return ocps
        planBean = plan.getPlanBean()
        for var in planBean.getVariables() or []:
            vname = var.getName()
            # Heuristic: OCP variables usually include 'ConnectionFactory' or 'ConnectionInstance'
            if 'ConnectionFactory' in vname or 'ConnectionInstance' in vname or 'Outbound' in vname:
                entries = []
                for ass in var.getVariableAssignments() or []:
                    m = ass.getTarget()
                    path = ass.getPlanPath()
                    entries.append({'target': safe(m.getName()), 'planPath': safe(path), 'value': safe(var.getValue())})
                ocps.append({'variable': vname, 'value': safe(var.getValue()), 'assignments': entries})
    except:
        pass
    cd('/')
    return ocps

for ad in JCA_ADAPTERS:
    ocps = scrape_adapter_ocps(ad)
    if ocps:
        manifest['jca'].append({'adapter': ad, 'ocps': ocps})

# ---------- OSB export (entire config or narrow by project) ----------
# Requires OSB WLST (run from OSB home). Exports to SB_JAR.
try:
    from com.bea.wli.config import Ref
    from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
    from javax.management import ObjectName

    sessionName = 'ExportSession-%d' % int(time.time())
    edit()
    startEdit()
    domainConfig()
    cd('/')
    mbs = cmo.getMBeanServer()
    alsbName = ObjectName(ALSBConfigurationMBean.OBJECT_NAME)
    alsb = mbs.newMBeanProxy(alsbName, ALSBConfigurationMBean, True)

    # Export everything (scope=None) – change to export only certain projects if you want.
    print('Exporting OSB config to: %s' % SB_JAR)
    alsb.exportToJar(SB_JAR, None, True, None)
    cancelEdit('norestart')
except Exception, e:
    print('OSB export skipped or failed: %s' % e)

# ---------- Save manifest ----------
MANIFEST = os.path.join(OUT_DIR, 'manifest-dev-%s.json' % time.strftime('%Y%m%d-%H%M%S'))
with open(MANIFEST, 'w') as f:
    json.dump(manifest, f, indent=2, sort_keys=True)

print('\nExport complete.')
print('  Manifest: %s' % MANIFEST)
if os.path.exists(SB_JAR):
    print('  OSB jar : %s' % SB_JAR)

disconnect()
exit()


