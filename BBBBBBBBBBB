# =============================================================================
# import_local.py — apply manifest (JDBC, JMS, subdeployments) to local WLS
# Usage: $WL_HOME/common/bin/wlst.sh import_local.py
# =============================================================================

# --- USER SETTINGS -----------------------------------------------------------
ADMIN_URL   = 't3://localhost:7101'     # JDeveloper Integrated default
ADMIN_USER  = 'weblogic'
ADMIN_PASS  = '***'

MANIFEST    = './export/manifest-dev-YYYYMMDD-HHMMSS.json'   # <-- set exact file
SB_JAR      = './export/sbconfig-dev-YYYYMMDD-HHMMSS.jar'    # <-- optional

FALLBACK_SERVER = 'DefaultServer'  # if dev targets don't exist locally

# --- IMPORTS ----------------------------------------------------------------
import os
from javax.management import ObjectName
from datetime import datetime

# --- tiny JSON loader (works on old Jython) ---------------------------------
def _parse_json_text(txt):
    # Try builtin json/simplejson if available; else very small safe eval for simple dict/list
    try:
        import json
        return json.loads(txt)
    except:
        try:
            import simplejson as json
            return json.loads(txt)
        except:
            # very limited: assumes the file was produced by our exporter (double quotes, null/true/false)
            rep = txt.replace('true','True').replace('false','False').replace('null','None')
            return eval(rep, {"__builtins__": {}})  # no builtins

def _load_manifest(path):
    fr = open(path, 'r')
    try:
        return _parse_json_text(fr.read())
    finally:
        fr.close()

# --- helpers ----------------------------------------------------------------
def _get_servers():
    cd('/Servers')
    L=[]; xs=cmo.getServers()
    if xs: 
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _get_clusters():
    cd('/Clusters')
    L=[]; xs=cmo.getClusters()
    if xs: 
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _map_targets(dev_names):
    servers=_get_servers(); clusters=_get_clusters()
    objs=[]
    for n in (dev_names or []):
        if n in servers:
            objs.append(ObjectName('com.bea:Name='+n+',Type=Server'))
        elif n in clusters:
            objs.append(ObjectName('com.bea:Name='+n+',Type=Cluster'))
    if len(objs)==0:
        if FALLBACK_SERVER in servers:
            objs=[ObjectName('com.bea:Name='+FALLBACK_SERVER+',Type=Server')]
        elif len(servers)>0:
            objs=[ObjectName('com.bea:Name='+servers[0]+',Type=Server')]
    return objs

def _ensure_jdbc(ds):
    name=ds.get('name'); jndi=ds.get('jndi') or []; url=ds.get('url'); driver=ds.get('driver'); props=ds.get('props') or {}
    print 'JDBC:', name
    cd('/')
    if not ls('/JDBCSystemResources/'+name, returnMap='true'):
        edit(); startEdit()
        cmo.createJDBCSystemResource(name)
        # JNDI
        try:
            cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDataSourceParams/'+name)
            from jarray import array as jarrayArray
            from java.lang import String
            set('JNDINames', jarrayArray(jndi, String))
        except: pass
        # Driver/URL
        try:
            cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDriverParams/'+name)
            if driver: cmo.setDriverName(driver)
            if url:    cmo.setUrl(url)
            # props
            try:
                cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDriverParams/'+name+'/Properties/'+name)
                for k in props.keys():
                    if not ls('Properties/'+k, returnMap='true'): cmo.createProperty(k)
                    cd('Properties/'+k); cmo.setValue(props[k]); cd('..')
            except: pass
        except: pass
        # Targets
        try:
            cd('/JDBCSystemResources/'+name)
            from jarray import array as jarrayArray
            set('Targets', jarrayArray(_map_targets(ds.get('targets')), ObjectName))
        except: pass
        save(); activate(block='true')
    else:
        print '  (exists)'

def _ensure_jms_module(mod):
    mname=mod.get('name')
    print 'JMS Module:', mname
    cd('/')
    if not ls('/JMSSystemResources/'+mname, returnMap='true'):
        edit(); startEdit()
        cmo.createJMSSystemResource(mname)
        try:
            cd('/JMSSystemResources/'+mname)
            from jarray import array as jarrayArray
            set('Targets', jarrayArray(_map_targets(mod.get('targets')), ObjectName))
        except: pass
        save(); activate(block='true')

    # ensure subdeployments first (targets on the module bean)
    subs=mod.get('subdeployments') or {}
    if len(subs)>0:
        edit(); startEdit()
        try:
            cd('/JMSSystemResources/'+mname)
            for sd in subs.keys():
                if not ls('SubDeployments/'+sd, returnMap='true'): cmo.createSubDeployment(sd)
                cd('SubDeployments/'+sd)
                from jarray import array as jarrayArray
                set('Targets', jarrayArray(_map_targets(subs[sd]), ObjectName))
                cd('..')
        except: pass
        save(); activate(block='true')

    # create resources if present (your current manifest has none, so this is a no-op)
    try:
        edit(); startEdit()
        cd('/JMSSystemResources/'+mname+'/JmsResource/'+mname)
    except:
        try:
            cd('/JMSSystemResources/'+mname); cmo.createJmsResource(mname)
            cd('/JMSSystemResources/'+mname+'/JmsResource/'+mname)
        except: pass

    # CFs
    for cf in mod.get('connectionFactories', []):
        try:
            nm=cf.get('name'); jndi=cf.get('jndi')
            if not ls('ConnectionFactories/'+nm, returnMap='true'):
                cmo.createConnectionFactory(nm)
                cd('ConnectionFactories/'+nm)
                if jndi: cmo.setJNDIName(jndi)
                cd('..')
        except: pass
    # Queues
    for q in mod.get('queues', []):
        try:
            nm=q.get('name'); jndi=q.get('jndi'); sd=q.get('subdeployment')
            if not ls('Queues/'+nm, returnMap='true'):
                cmo.createQueue(nm)
                cd('Queues/'+nm)
                if jndi: cmo.setJNDIName(jndi)
                if sd:   cmo.setSubDeploymentName(sd)
                cd('..')
        except: pass
    # Topics
    for t in mod.get('topics', []):
        try:
            nm=t.get('name'); jndi=t.get('jndi'); sd=t.get('subdeployment')
            if not ls('Topics/'+nm, returnMap='true'):
                cmo.createTopic(nm)
                cd('Topics/'+nm)
                if jndi: cmo.setJNDIName(jndi)
                if sd:   cmo.setSubDeploymentName(sd)
                cd('..')
        except: pass

    try: save(); activate(block='true')
    except: pass

def _import_osb_if_any(path_jar):
    if not (path_jar and os.path.exists(path_jar)):
        print 'OSB jar not found -> skip'
        return
    try:
        from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
        alsb = findService(ALSBConfigurationMBean.NAME, ALSBConfigurationMBean.TYPE)
        if alsb is None:
            print 'ALSB MBean not available in this WLST; skip OSB import.'
            return
        print 'Importing OSB JAR:', path_jar
        try:
            alsb.importToDomain(path_jar, True)  # some 12c builds
        except:
            try:
                # fallback session-based import if available in your environment
                # (commented; many Integrated domains lack this)
                pass
            except:
                print '  OSB import method not supported here.'
    except:
        print '  OSB APIs not present; skipping.'

# --- run ---------------------------------------------------------------------
def main():
    connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
    domainConfig()

    man = _load_manifest(MANIFEST)

    # JDBC
    for ds in man.get('jdbc', []):
        try: _ensure_jdbc(ds)
        except: print '  ! JDBC error for', ds.get('name')

    # JMS
    for mod in man.get('jms', []):
        try: _ensure_jms_module(mod)
        except: print '  ! JMS error for', mod.get('name')

    # OSB (optional)
    _import_osb_if_any(SB_JAR)

    disconnect(); exit()

main()


