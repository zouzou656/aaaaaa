2) Enhanced Importer — import_local_jca.py

This reads the new jca section and ensures every exported JNDI exists as a connection-instance in the adapter’s plan on your local domain. If the adapter has no plan attached, it creates/attaches a plan.xml (under the adapter’s deployment folder), then redeploys the adapter so WebLogic picks up the new plan.

# =============================================================================
# import_local_jca.py — Import JDBC/JMS and JCA adapter JNDIs into LOCAL WLS
# Usage: $WL_HOME/common/bin/wlst.sh import_local_jca.py
# =============================================================================

# --- USER SETTINGS -----------------------------------------------------------
ADMIN_URL   = 't3://localhost:7101'      # JDeveloper Integrated default
ADMIN_USER  = 'weblogic'
ADMIN_PASS  = '***'

MANIFEST    = r'.\export\manifest-dev-YYYYMMDD-HHMMSS.json'   # <-- set exact file path

FALLBACK_SERVER = 'DefaultServer'  # for JMS/JDBC mapping

# --- IMPORTS / LOGGING -------------------------------------------------------
import os
from javax.management import ObjectName
from datetime import datetime

def stamp(): return datetime.now().strftime('%H:%M:%S')
def log(msg):  print '[%s] %s' % (stamp(), msg)
def ok(msg):   print '[%s]   ✅ %s' % (stamp(), msg)
def warn(msg): print '[%s]   ⚠️  %s' % (stamp(), msg)
def err(msg):  print '[%s]   ❌ %s' % (stamp(), msg)
def step(msg): print '\n[%s] ▶ %s' % (stamp(), msg)

# --- tiny JSON loader --------------------------------------------------------
def _parse_json_text(txt):
    try:
        import json; return json.loads(txt)
    except:
        try:
            import simplejson as json; return json.loads(txt)
        except:
            rep=txt.replace('true','True').replace('false','False').replace('null','None')
            return eval(rep, {"__builtins__": {}})

def _load_manifest(path):
    fr=open(path,'r'); s=fr.read(); fr.close(); return _parse_json_text(s)

# --- helpers ----------------------------------------------------------------
def _pwd():
    try: return pwd()
    except: return '(unknown)'

def _ensure_edit():
    try:
        edit(); startEdit(waitTimeInMillis=600000)
        return True
    except:
        return True

def _activate():
    try:
        save(); activate(block='true'); ok('Changes activated'); return True
    except:
        err('Activation failed'); return False

def _get_servers():
    cd('/Servers'); L=[]; xs=cmo.getServers()
    if xs:
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _get_clusters():
    cd('/Clusters'); L=[]; xs=cmo.getClusters()
    if xs:
        for i in range(len(xs)): L.append(xs[i].getName())
    cd('/'); return L

def _map_targets(dev_names):
    servers=_get_servers(); clusters=_get_clusters()
    objs=[]
    for n in (dev_names or []):
        if n in servers:  objs.append(ObjectName('com.bea:Name='+n+',Type=Server'))
        elif n in clusters: objs.append(ObjectName('com.bea:Name='+n+',Type=Cluster'))
    if len(objs)==0:
        if FALLBACK_SERVER in servers:
            objs=[ObjectName('com.bea:Name='+FALLBACK_SERVER+',Type=Server')]
        elif len(servers)>0:
            objs=[ObjectName('com.bea:Name='+servers[0]+',Type=Server')]
    return objs

# --- JDBC (same as before, condensed) ---------------------------------------
def ensure_jdbc(ds, results):
    name=ds.get('name'); jndi=ds.get('jndi') or []; url=ds.get('url'); driver=ds.get('driver'); props=ds.get('props') or {}
    step('JDBC: %s' % name)
    try:
        cd('/')
        if ls('/JDBCSystemResources/'+name, returnMap='true'):
            ok('(exists) JDBCSystemResource/%s' % name); results['jdbc_exists'].append(name); return
        _ensure_edit()
        cmo.createJDBCSystemResource(name); ok('Created JDBCSystemResource/%s' % name)

        try:
            cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDataSourceParams/'+name)
            from jarray import array as jarrayArray; from java.lang import String
            set('JNDINames', jarrayArray(jndi, String)); ok('JNDI=%s' % (jndi,))
        except: warn('Set JNDI failed (pwd=%s)' % _pwd())

        try:
            cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDriverParams/'+name)
            if driver: cmo.setDriverName(driver)
            if url:    cmo.setUrl(url)
            try:
                cd('/JDBCSystemResources/'+name+'/JdbcResource/'+name+'/JDBCDriverParams/'+name+'/Properties/'+name)
                for k in props.keys():
                    if not ls('Properties/'+k, returnMap='true'): cmo.createProperty(k)
                    cd('Properties/'+k); cmo.setValue(props[k]); cd('..')
                ok('Driver properties set: %s' % (props.keys(),))
            except: pass
        except: warn('Set Driver/URL failed (pwd=%s)' % _pwd())

        try:
            cd('/JDBCSystemResources/'+name)
            from jarray import array as jarrayArray
            set('Targets', jarrayArray(_map_targets(ds.get('targets')), ObjectName)); ok('Targets set')
        except: warn('Set Targets failed (pwd=%s)' % _pwd())

        if _activate(): results['jdbc_ok'].append(name)
        else: results['jdbc_fail'].append(name)
    except:
        err('JDBC failed: %s' % name); results['jdbc_fail'].append(name)

# --- JMS (same as before, condensed & corrected) ----------------------------
def ensure_jms_module(mod, results):
    mname=mod.get('name'); step('JMS Module: %s' % mname)
    try:
        cd('/')
        if not ls('/JMSSystemResources/'+mname, returnMap='true'):
            _ensure_edit(); cmo.createJMSSystemResource(mname); ok('Created JMSSystemResource/%s' % mname)
            try:
                cd('/JMSSystemResources/'+mname)
                from jarray import array as jarrayArray
                set('Targets', jarrayArray(_map_targets(mod.get('targets')), ObjectName)); ok('Module targets set')
            except: warn('Set module targets failed (pwd=%s)' % _pwd())
            _activate()
        else:
            ok('(exists) JMSSystemResource/%s' % mname)

        subs=mod.get('subdeployments') or {}
        if len(subs)>0:
            _ensure_edit()
            cd('/JMSSystemResources/'+mname)
            for sd in subs.keys():
                if not ls('SubDeployments/'+sd, returnMap='true'): cmo.createSubDeployment(sd); ok('Created SubDeployment/%s' % sd)
                cd('SubDeployments/'+sd)
                from jarray import array as jarrayArray
                set('Targets', jarrayArray(_map_targets(subs[sd]), ObjectName)); ok('SubDeployment %s targets set' % sd)
                cd('..')
            _activate()

        # Ensure JMSResource (case!)
        try:
            cd('/JMSSystemResources/%s/JMSResource/%s' % (mname, mname))
        except:
            _ensure_edit()
            cd('/JMSSystemResources/'+mname); cmo.createJmsResource(mname); ok('Created JMSResource/%s' % mname); _activate()

        # CFs / Queues / Topics (create if present in manifest)
        try:
            cd('/JMSSystemResources/%s/JMSResource/%s' % (mname, mname))
            for cf in mod.get('connectionFactories', []):
                nm=cf.get('name'); jndi=cf.get('jndi')
                if not ls('ConnectionFactories/'+nm, returnMap='true'):
                    _ensure_edit(); cmo.createConnectionFactory(nm); cd('ConnectionFactories/'+nm)
                    if jndi: cmo.setJNDIName(jndi); ok('CF %s (JNDI=%s)' % (nm,jndi)); _activate()
            for q in mod.get('queues', []):
                nm=q.get('name'); jndi=q.get('jndi'); sd=q.get('subdeployment')
                if not ls('Queues/'+nm, returnMap='true'):
                    _ensure_edit(); cmo.createQueue(nm); cd('Queues/'+nm)
                    if jndi: cmo.setJNDIName(jndi)
                    if sd:   cmo.setSubDeploymentName(sd)
                    ok('Queue %s (JNDI=%s, SD=%s)' % (nm,jndi,sd)); _activate()
            for t in mod.get('topics', []):
                nm=t.get('name'); jndi=t.get('jndi'); sd=t.get('subdeployment')
                if not ls('Topics/'+nm, returnMap='true'):
                    _ensure_edit(); cmo.createTopic(nm); cd('Topics/'+nm)
                    if jndi: cmo.setJNDIName(jndi)
                    if sd:   cmo.setSubDeploymentName(sd)
                    ok('Topic %s (JNDI=%s, SD=%s)' % (nm,jndi,sd)); _activate()
        except: pass

        results['jms_ok'].append(mname)
    except:
        err('JMS module failed: %s' % mname); results['jms_fail'].append(mname)

# --- JCA (NEW): ensure adapter plan has all connection-instances -------------
def _default_adapter_plan_path(adapter):
    # Try to place a plan under the deployment if possible; Integrated domains vary.
    domain_home = cmo.getRootDirectory()  # DomainMBean
    if domain_home is None: domain_home = os.getcwd()
    # typical: <DOMAIN>/config/deployments/<Adapter>/plan/plan.xml
    return os.path.join(domain_home, 'config', 'deployments', adapter, 'plan', 'plan.xml')

def ensure_adapter_instances(adapter, instances, results):
    step('JCA Adapter: %s' % adapter)
    try:
        path='/AppDeployments/'+adapter
        if not ls(path, returnMap='true'):
            warn('Adapter not deployed locally: %s' % adapter); results['jca_miss'].append(adapter); return
        cd(path)
        app=cmo; plan=app.getDeploymentPlan()
        # Attach a plan if missing
        if plan is None:
            _ensure_edit()
            plan_path=_default_adapter_plan_path(adapter)
            plan_dir = os.path.dirname(plan_path)
            if not os.path.isdir(plan_dir): os.makedirs(plan_dir)
            cmo.setPlanPath(plan_path)
            ok('Attached new plan to %s -> %s' % (adapter, plan_path))
            _activate()
            cd(path); app=cmo; plan=app.getDeploymentPlan()

        if plan is None:
            err('Plan still None for %s' % adapter); results['jca_fail'].append(adapter); cd('/'); return

        planBean=plan.getPlanBean()
        # Get/Create ModuleOverride for this rar
        mos=planBean.getModuleOverrides()
        mo=None
        if mos:
            i=0
            while i<len(mos):
                m=mos[i]
                if m.getModuleType()=='rar':
                    if (m.getModuleName() is None) or (m.getModuleName()==adapter):
                        mo=m; break
                i+=1
        if mo is None:
            mo=planBean.createModuleOverride()
            mo.setModuleType('rar')
            mo.setModuleName(adapter)
            ok('Created ModuleOverride for %s' % adapter)

        # Current instances in plan
        existing=set()
        cos=mo.getConnectionInstanceOverrides()
        if cos:
            i=0
            while i<len(cos):
                co=cos[i]
                if co.getJndiName(): existing.add(str(co.getJndiName()))
                i+=1

        # Add missing instances
        missing=[]
        i=0
        while i<len(instances):
            jndi = instances[i].get('jndi')
            if jndi and (jndi not in existing):
                co = mo.createConnectionInstanceOverride()
                co.setJndiName(jndi)
                missing.append(jndi)
            i+=1

        if len(missing)>0:
            ok('Adding %d connection-instances: %s' % (len(missing), missing))
            _ensure_edit(); save(); activate(block='true')
            # redeploy adapter so plan takes effect
            try:
                redeploy(adapter); ok('Redeployed %s' % adapter)
                results['jca_ok'].append({'adapter':adapter,'added':missing})
            except:
                warn('Redeploy failed for %s (check manually)' % adapter)
                results['jca_ok'].append({'adapter':adapter,'added':missing,'redeploy':'failed'})
        else:
            ok('All instances already present')
            results['jca_ok'].append({'adapter':adapter,'added':[]})

        cd('/')

    except:
        err('JCA plan update failed: %s' % adapter); results['jca_fail'].append(adapter); cd('/')

# --- RUN ---------------------------------------------------------------------
def main():
    step('Connect to Admin')
    connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
    ok('Connected to %s' % ADMIN_URL)
    domainConfig(); ok('In domainConfig tree')

    man=_load_manifest(MANIFEST)
    results={'jdbc_ok':[],'jdbc_fail':[],'jdbc_exists':[],'jms_ok':[],'jms_fail':[],'jca_ok':[],'jca_fail':[],'jca_miss':[]}

    # JDBC
    for ds in man.get('jdbc', []): ensure_jdbc(ds, results)

    # JMS
    for mod in man.get('jms', []): ensure_jms_module(mod, results)

    # JCA (NEW)
    for jca in man.get('jca', []):
        adapter = jca.get('adapter')
        instances = jca.get('instances') or []
        ensure_adapter_instances(adapter, instances, results)

    # Summary
    step('RESULT SUMMARY')
    print 'JDBC created   :', results['jdbc_ok']
    print 'JDBC existed   :', results['jdbc_exists']
    print 'JDBC failed    :', results['jdbc_fail']
    print 'JMS ok         :', results['jms_ok']
    print 'JMS failed     :', results['jms_fail']
    print 'JCA updated    :', results['jca_ok']
    print 'JCA failed     :', results['jca_fail']
    print 'JCA not found  :', results['jca_miss']

    disconnect(); ok('Disconnected'); exit()

main()


