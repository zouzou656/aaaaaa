Script B — import_local.py (run against LOCAL Integrated WLS)

# ============================================================================
# import_local.py — Run with: ${WL_HOME}/common/bin/wlst.sh import_local.py
# Applies: creates missing JDBC/JMS, applies JCA OCPs (via plan vars),
#          imports OSB sbconfig.jar into local Integrated domain.
# ============================================================================

import json, os, time

# ---------- USER VARS ----------
ADMIN_URL    = 't3://localhost:7101' # JDev Integrated default; change if needed
ADMIN_USER   = 'weblogic'
ADMIN_PASS   = '***'

MANIFEST     = './export/manifest-dev-YYYYMMDD-HHMMSS.json'  # <-- put the real file
SB_JAR       = './export/sbconfig-dev-YYYYMMDD-HHMMSS.jar'   # <-- put the real file

# Default JDBC target(s) when target from dev doesn’t exist locally
DEFAULT_TARGETS = ['DefaultServer']  # for Integrated domain

# ---------- Helpers ----------
def choose_targets(dev_targets):
    # Map dev targets to local; fallback to DEFAULT_TARGETS
    existing = []
    cd('/Servers')
    existingServers = [s.getName() for s in cmo.getServers() or []]
    cd('/')
    cd('/Clusters')
    existingClusters = [c.getName() for c in cmo.getClusters() or []]
    cd('/')
    out = []
    for t in dev_targets or []:
        if t in existingServers or t in existingClusters:
            out.append(t)
    return out or DEFAULT_TARGETS

def ensure_jdbc(j):
    name = j['name']; jndi = j['jndi']; url = j['url']; driver=j['driver']; props=j['props']; tgts=j['targets']
    print('Ensuring JDBC: %s' % name)
    cd('/')
    if not ls('/JDBCSystemResources/%s' % name, returnMap='true'):
        edit(); startEdit()
        cmo.createJDBCSystemResource(name)
        cd('/JDBCSystemResources/%s/JdbcResource/%s' % (name, name))
        cmo.setName(name)
        cd('JDBCDataSourceParams/%s' % name); set('JNDINames', jarray.array(jndi, String))
        cd('../JDBCDriverParams/%s' % name); cmo.setDriverName(driver); cmo.setUrl(url)
        # user/pass can’t be read from DEV; set manually if needed
        for k,v in (props or {}).items():
            cd('../JDBCDriverParams/%s/Properties/%s' % (name, name))
            if not ls('Properties/%s' % k, returnMap='true'):
                cmo.createProperty(k)
            cd('Properties/%s' % k); cmo.setValue(v); cd('/JDBCSystemResources/%s/JdbcResource/%s' % (name, name))
        # Targets
        cd('/JDBCSystemResources/%s' % name)
        tg = choose_targets(tgts)
        set('Targets', jarray.array([ObjectName('com.bea:Name=%s,Type=%s' % (t, 'Server')) if t in existingServers() else ObjectName('com.bea:Name=%s,Type=Cluster' % t) for t in tg], ObjectName))
        save(); activate(block='true')
    else:
        print('  Exists, skipping create.')

def existingServers():
    cd('/Servers'); return [s.getName() for s in cmo.getServers() or []]

def ensure_jms(mod):
    mname = mod['name']
    print('Ensuring JMS Module: %s' % mname)
    cd('/')
    if not ls('/JMSSystemResources/%s' % mname, returnMap='true'):
        edit(); startEdit()
        cmo.createJMSSystemResource(mname)
        cd('/JMSSystemResources/%s' % mname)
        tg = choose_targets(mod['targets'])
        set('Targets', jarray.array([ObjectName('com.bea:Name=%s,Type=%s' % (t, 'Server')) if t in existingServers() else ObjectName('com.bea:Name=%s,Type=Cluster' % t) for t in tg], ObjectName))
        save(); activate(block='true')
    # CFs, queues, topics, subdeployments
    edit(); startEdit()
    cd('/JMSSystemResources/%s/JmsResource/%s' % (mname, mname))
    # CFs
    for cf in mod.get('connectionFactories', []):
        if not ls('ConnectionFactories/%s' % cf['name'], returnMap='true'):
            cmo.createConnectionFactory(cf['name'])
            cd('ConnectionFactories/%s' % cf['name']); cmo.setJNDIName(cf['jndi']); cd('..')
    # Subdeployments
    cd('/JMSSystemResources/%s' % mname)
    for sd, tgts in (mod.get('subdeployments', {}) or {}).items():
        if not ls('SubDeployments/%s' % sd, returnMap='true'):
            cmo.createSubDeployment(sd)
        cd('SubDeployments/%s' % sd)
        # map SD targets to local
        mapped = choose_targets(tgts)
        set('Targets', jarray.array([ObjectName('com.bea:Name=%s,Type=%s' % (t, 'Server')) if t in existingServers() else ObjectName('com.bea:Name=%s,Type=Cluster' % t) for t in mapped], ObjectName))
        cd('/JMSSystemResources/%s' % mname)
    # Destinations
    cd('/JMSSystemResources/%s/JmsResource/%s' % (mname, mname))
    for q in mod.get('queues', []):
        if not ls('Queues/%s' % q['name'], returnMap='true'):
            cmo.createQueue(q['name'])
            cd('Queues/%s' % q['name']); cmo.setJNDIName(q['jndi'])
            if q.get('subdeployment'): cmo.setSubDeploymentName(q['subdeployment'])
            cd('..')
    for t in mod.get('topics', []):
        if not ls('Topics/%s' % t['name'], returnMap='true'):
            cmo.createTopic(t['name'])
            cd('Topics/%s' % t['name']); cmo.setJNDIName(t['jndi'])
            if t.get('subdeployment'): cmo.setSubDeploymentName(t['subdeployment'])
            cd('..')
    save(); activate(block='true')

def apply_jca_ocps(adapter, ocps):
    # NOTE: Plan editing is tricky; we leverage variable values present in manifest.
    # This applies values to deployment plan variables if they exist locally.
    depPath = '/Deployments/%s' % adapter
    if not ls(depPath, returnMap='true'):
        print('  [%s] not deployed in local Integrated domain; skipping OCP apply.' % adapter)
        return
    cd(depPath)
    app = cmo
    plan = app.getDeploymentPlan()
    if plan is None:
        print('  [%s] has no deployment plan; skipping.' % adapter); cd('/'); return
    planBean = plan.getPlanBean()
    changed = False
    for ocp in ocps:
        vname = ocp.get('variable'); val = ocp.get('value')
        for var in planBean.getVariables() or []:
            if var.getName() == vname and val is not None:
                print('    Setting plan var %s = %s' % (vname, val))
                var.setValue(val); changed = True
    if changed:
        edit(); startEdit()
        save(); activate(block='true')
        print('  Applied plan variable values for %s' % adapter)
    cd('/')

def import_osb(sbjar):
    print('Importing OSB: %s' % sbjar)
    from com.bea.wli.sb.management.configuration import ALSBConfigurationMBean
    from javax.management import ObjectName
    edit(); startEdit()
    domainConfig()
    mbs = cmo.getMBeanServer()
    alsb = mbs.newMBeanProxy(ObjectName(ALSBConfigurationMBean.OBJECT_NAME), ALSBConfigurationMBean, True)
    # create a session
    session = 'ImportSession-%d' % int(time.time())
    alsb.createSession(session)
    # import jar into session
    alsb.importFromJar(sbjar, True, None, session)
    # activate
    alsb.activateSession(session, 'Imported by WLST')
    save(); activate(block='true')
    print('OSB import done.')

# ---------- Connect & Apply ----------
connect(ADMIN_USER, ADMIN_PASS, ADMIN_URL)
domainRuntime()

with open(MANIFEST) as f:
    man = json.load(f)

# JDBC
for j in man.get('jdbc', []):
    ensure_jdbc(j)

# JMS
for mod in man.get('jms', []):
    ensure_jms(mod)

# JCA OCPs
for jca in man.get('jca', []):
    apply_jca_ocps(jca['adapter'], jca['ocps'])

# OSB
if os.path.exists(SB_JAR):
    import_osb(SB_JAR)
else:
    print('OSB jar not found, skipping.')

disconnect()
exit()


