clone_jdbc_and_hook_dbadapter.py

# -*- coding: ascii -*-
# =============================================================================
# clone_jdbc_and_hook_dbadapter.py
#
# One-shot cloner:
#   1) Connect to DEV -> read all JDBC datasources and DbAdapter plan links
#   2) Connect to LOCAL -> create same JDBC on DefaultServer and hook DbAdapter
#
# Usage:
#   $WL_HOME/common/bin/wlst.sh clone_jdbc_and_hook_dbadapter.py
#
# Notes:
#   - Passwords in DEV JDBC are not readable; this script creates datasources
#     with URL/driver/JNDI/properties except password. Set passwords locally once
#     in the Console or extend this script to inject from environment.
#   - Targets: always mapped to DefaultServer if it exists; otherwise to the
#     first available server in the local domain.
#   - DbAdapter: creates connection-instances (by JNDI) if missing and sets
#     DataSourceName/xADataSourceName from DEV values. Redeploys DbAdapter.
# =============================================================================

# ----------------------- USER SETTINGS ---------------------------------------
DEV_ADMIN_URL   = 't3s://dev-admin-host:7002'    # change
DEV_ADMIN_USER  = 'weblogic'                     # change
DEV_ADMIN_PASS  = '***'                          # change

LOCAL_ADMIN_URL  = 't3://localhost:7101'         # JDev Integrated default
LOCAL_ADMIN_USER = 'weblogic'                    # change if needed
LOCAL_ADMIN_PASS = '***'                         # change if needed

LOCAL_FALLBACK_SERVER = 'DefaultServer'          # target here on local

# If you need to exclude obvious system datasources, set to True
EXCLUDE_SYSTEM_JDBC = False

# ----------------------- IMPORTS ---------------------------------------------
from datetime import datetime
import os
from javax.management import ObjectName

# ----------------------- LOGGING ---------------------------------------------
def ts(): return datetime.now().strftime('%H:%M:%S')
def info(msg): print '[%s] %s' % (ts(), msg)
def step(msg): print '\n[%s] >>> %s' % (ts(), msg)

# ----------------------- FILTERS (optional) ----------------------------------
_EXCLUDE_JDBC_PREFIX = (
  'SOADataSource','EDNDataSource','EDNLocalTxDataSource','OraSDPMDataSource',
  'mds-','opss-','wlsbjmsrp','WLSSchemaDataSource','LocalSvcTblDataSource',
  'SOALocalTxDataSource','SOA_MDS','FMwDT','FMWDT','Audit','bam','mds-owsm',
  'SOAINFRA','ESSDS','UmsDataSource','RSMANAGEDDS','STBDataSource'
)

def _skip_jdbc(name):
    if not EXCLUDE_SYSTEM_JDBC:
        return False
    if name is None: return True
    low = name.lower()
    i = 0
    while i < len(_EXCLUDE_JDBC_PREFIX):
        if low.startswith(_EXCLUDE_JDBC_PREFIX[i].lower()):
            return True
        i += 1
    return False

# ----------------------- DEV EXPORT ------------------------------------------
def dev_export_jdbc_and_dbadapter():
    """
    Returns:
      jdbc_list: [ {name, jndi[], driver, url, props{}} ... ]
      db_ci_map: { jndi_string : { 'DataSourceName': 'jdbc/Name', 'xADataSourceName': 'jdbc/Name' } }
    """
    jdbc_list = []
    db_ci_map = {}

    info('Connecting to DEV: %s' % DEV_ADMIN_URL)
    connect(DEV_ADMIN_USER, DEV_ADMIN_PASS, DEV_ADMIN_URL)
    domainConfig()
    info('Connected to DEV and in domainConfig')

    # JDBC export
    try:
        cd('/JDBCSystemResources')
        jdbcs = cmo.getJDBCSystemResources()
        if jdbcs:
            i = 0
            while i < len(jdbcs):
                jdbc = jdbcs[i]; i += 1
                name = jdbc.getName()
                if _skip_jdbc(name):
                    continue

                jndi = []
                driver = None
                url = None
                props = {}

                # JNDI names
                try:
                    cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDataSourceParams/%s' % (name, name, name))
                    jn = cmo.getJNDINames()
                    if jn:
                        k = 0
                        while k < len(jn):
                            jndi.append(jn[k]); k += 1
                except:
                    pass

                # Driver/URL/Properties (password not readable)
                try:
                    cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s' % (name, name, name))
                    try: driver = str(cmo.getDriverName())
                    except: driver = None
                    try: url = str(cmo.getUrl())
                    except: url = None
                    try:
                        pset = cmo.getProperties()
                        if pset:
                            plist = pset.getProperties()
                            if plist:
                                p = 0
                                while p < len(plist):
                                    pr = plist[p]
                                    pname = pr.getName()
                                    pval  = pr.getValue()
                                    # do not attempt to read or set password here
                                    props[pname] = None if pval is None else str(pval)
                                    p += 1
                    except:
                        pass
                except:
                    pass

                cd('/')
                jdbc_list.append({'name': name, 'jndi': jndi, 'driver': driver, 'url': url, 'props': props})
    except:
        info('Warning: could not enumerate DEV JDBCSystemResources')

    # DbAdapter plan: map each connection-instance JNDI to its datasource property
    try:
        adapter = 'DbAdapter'
        path = '/AppDeployments/%s' % adapter
        if ls(path, returnMap='true'):
            cd(path)
            app = cmo
            plan = app.getDeploymentPlan()
            if plan:
                planBean = plan.getPlanBean()
                mos = planBean.getModuleOverrides()
                if mos:
                    idx = 0
                    while idx < len(mos):
                        mo = mos[idx]; idx += 1
                        if mo.getModuleType() == 'rar':
                            if mo.getModuleName() and mo.getModuleName() != adapter:
                                continue
                            cos = mo.getConnectionInstanceOverrides()
                            if cos:
                                j = 0
                                while j < len(cos):
                                    co = cos[j]; j += 1
                                    jndi = co.getJndiName()
                                    if jndi:
                                        jndi_s = str(jndi)
                                        # collect datasource property overrides
                                        entry = {}
                                        try:
                                            cprops = co.getConnectionPropertyOverrides()
                                            if cprops:
                                                k = 0
                                                while k < len(cprops):
                                                    cpo = cprops[k]; k += 1
                                                    pname = cpo.getName()
                                                    pval  = cpo.getValue()
                                                    if pname in ('DataSourceName', 'xADataSourceName'):
                                                        entry[pname] = None if pval is None else str(pval)
                                        except:
                                            pass
                                        if len(entry) > 0:
                                            db_ci_map[jndi_s] = entry
            cd('/')
    except:
        info('Warning: could not read DbAdapter plan on DEV')

    disconnect()
    info('Disconnected from DEV')

    return jdbc_list, db_ci_map

# ----------------------- LOCAL HELPERS ---------------------------------------
def local_servers():
    cd('/Servers'); L = []; xs = cmo.getServers()
    if xs:
        i = 0
        while i < len(xs):
            L.append(xs[i].getName()); i += 1
    cd('/'); return L

def local_default_target():
    servers = local_servers()
    if LOCAL_FALLBACK_SERVER in servers:
        return [ObjectName('com.bea:Name=' + LOCAL_FALLBACK_SERVER + ',Type=Server')]
    if len(servers) > 0:
        return [ObjectName('com.bea:Name=' + servers[0] + ',Type=Server')]
    return []

def ensure_edit():
    try:
        edit(); startEdit(waitTimeInMillis=600000)
        return True
    except:
        return True

def activate_changes():
    try:
        save(); activate(block='true')
        return True
    except:
        return False

# ----------------------- LOCAL CREATE JDBC -----------------------------------
def local_create_jdbc(ds):
    name   = ds.get('name')
    jndi   = ds.get('jndi') or []
    url    = ds.get('url')
    driver = ds.get('driver')
    props  = ds.get('props') or {}

    info('JDBC: %s' % name)

    cd('/')
    if ls('/JDBCSystemResources/' + name, returnMap='true'):
        info('  Exists, skipping create: %s' % name)
        return True

    ensure_edit()
    try:
        cmo.createJDBCSystemResource(name)
        info('  Created JDBCSystemResource/%s' % name)

        # JNDI
        try:
            cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDataSourceParams/%s' % (name, name, name))
            from jarray import array as jarrayArray
            from java.lang import String
            set('JNDINames', jarrayArray(jndi, String))
            info('  JNDI names set: %s' % (jndi,))
        except:
            info('  Warning: could not set JNDI names for %s' % name)

        # Driver and URL
        try:
            cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s' % (name, name, name))
            if driver:
                cmo.setDriverName(driver)
                info('  DriverName = %s' % driver)
            if url:
                cmo.setUrl(url)
                info('  URL = %s' % url)
            # Properties (except password)
            try:
                cd('/JDBCSystemResources/%s/JdbcResource/%s/JDBCDriverParams/%s/Properties/%s' % (name, name, name, name))
                keys = props.keys()
                i = 0
                while i < len(keys):
                    k = keys[i]; i += 1
                    if k is None:
                        continue
                    # do not set password here
                    if str(k).lower().find('password') != -1:
                        continue
                    if not ls('Properties/' + k, returnMap='true'):
                        cmo.createProperty(k)
                    cd('Properties/' + k)
                    cmo.setValue(props[k])
                    cd('..')
                info('  Driver properties set (except password)')
            except:
                pass
        except:
            info('  Warning: could not set Driver/URL for %s' % name)

        # Targets
        try:
            cd('/JDBCSystemResources/' + name)
            from jarray import array as jarrayArray
            mapped = local_default_target()
            set('Targets', jarrayArray(mapped, ObjectName))
            info('  Targeted to local server(s): %s' % (mapped,))
        except:
            info('  Warning: could not set Targets for %s' % name)

        if activate_changes():
            info('  Activated: %s' % name)
            return True
        else:
            info('  Activate failed for %s' % name)
            return False
    except:
        info('  Create failed for %s' % name)
        return False

# ----------------------- LOCAL HOOK DBADAPTER --------------------------------
def ensure_dbadapter_hook(ci_map):
    """
    ci_map: { 'eis/DB/xxxx' : {'DataSourceName':'jdbc/Name', 'xADataSourceName':'jdbc/Name'} }
    Ensures DbAdapter has plan, connection-instances by JNDI, and properties set.
    """
    adapter = 'DbAdapter'
    path = '/AppDeployments/' + adapter
    if not ls(path, returnMap='true'):
        info('DbAdapter is not deployed locally; skipping adapter hook')
        return False

    cd(path)
    app = cmo
    plan = app.getDeploymentPlan()
    if plan is None:
        # attach a plan under domain deployments
        try:
            ensure_edit()
            try:
                cd('/')
                domain_home = cmo.getRootDirectory()
            except:
                domain_home = None
            if domain_home is None:
                domain_home = os.getcwd()
            plan_path = os.path.join(domain_home, 'config', 'deployments', adapter, 'plan', 'plan.xml')
            plan_dir = os.path.dirname(plan_path)
            if not os.path.isdir(plan_dir):
                os.makedirs(plan_dir)
            cd('/AppDeployments/' + adapter)
            cmo.setPlanPath(plan_path)
            if activate_changes():
                info('Attached new plan to %s at %s' % (adapter, plan_path))
            cd('/AppDeployments/' + adapter)
            plan = cmo.getDeploymentPlan()
        except:
            info('Failed to attach a plan to DbAdapter')
            cd('/')
            return False

    if plan is None:
        info('DbAdapter plan is still None; aborting hook')
        cd('/')
        return False

    planBean = plan.getPlanBean()

    # Find or create ModuleOverride for RAR
    mos = planBean.getModuleOverrides()
    mo = None
    if mos:
        i = 0
        while i < len(mos):
            m = mos[i]; i += 1
            if m.getModuleType() == 'rar':
                if (m.getModuleName() is None) or (m.getModuleName() == adapter):
                    mo = m
                    break
    if mo is None:
        mo = planBean.createModuleOverride()
        mo.setModuleType('rar'); mo.setModuleName(adapter)
        info('Created ModuleOverride for %s' % adapter)

    # Index existing connection-instances by JNDI
    existing = {}
    cos = mo.getConnectionInstanceOverrides()
    if cos:
        i = 0
        while i < len(cos):
            co = cos[i]; i += 1
            jndi = co.getJndiName()
            if jndi:
                existing[str(jndi)] = co

    # Ensure instances and set datasource properties
    added = []
    updated = []
    keys = ci_map.keys()
    i = 0
    while i < len(keys):
        jndi = keys[i]; i += 1
        cfg = ci_map[jndi]
        if existing.has_key(jndi):
            co = existing[jndi]
        else:
            co = mo.createConnectionInstanceOverride()
            co.setJndiName(jndi)
            added.append(jndi)
        # set properties
        # try xADataSourceName first, else DataSourceName
        xa = cfg.get('xADataSourceName')
        ds = cfg.get('DataSourceName')
        # get or create property overrides
        def set_prop(coBean, pname, pval):
            if pval is None:
                return False
            cprops = coBean.getConnectionPropertyOverrides()
            # find existing
            found = None
            if cprops:
                k = 0
                while k < len(cprops):
                    cpo = cprops[k]; k += 1
                    if cpo.getName() == pname:
                        found = cpo; break
            if found is None:
                found = coBean.createConnectionPropertyOverride()
                found.setName(pname)
            found.setValue(pval)
            return True

        changed = False
        if xa:
            if set_prop(co, 'xADataSourceName', xa):
                changed = True
        if ds:
            if set_prop(co, 'DataSourceName', ds):
                changed = True
        if changed and (jndi not in added):
            updated.append(jndi)

    # Save plan and redeploy adapter
    ensure_edit()
    ok = activate_changes()
    try:
        redeploy(adapter)
    except:
        info('Redeploy of DbAdapter failed; check manually')

    info('DbAdapter hook summary: added instances=%s, updated instances=%s' % (added, updated))
    cd('/')
    return True

# ----------------------- MAIN ------------------------------------------------
def main():
    step('DEV: export JDBC and DbAdapter links')
    jdbc_list, db_ci_map = dev_export_jdbc_and_dbadapter()
    info('DEV JDBC count: %d' % len(jdbc_list))
    info('DEV DbAdapter CI entries: %d' % len(db_ci_map.keys()))

    step('LOCAL: connect')
    connect(LOCAL_ADMIN_USER, LOCAL_ADMIN_PASS, LOCAL_ADMIN_URL)
    domainConfig()
    info('Connected to LOCAL and in domainConfig')

    # Create JDBC locally
    success = 0; failed = 0
    i = 0
    while i < len(jdbc_list):
        if local_create_jdbc(jdbc_list[i]):
            success += 1
        else:
            failed += 1
        i += 1
    info('LOCAL JDBC created=%d, failed=%d' % (success, failed))

    # Hook DbAdapter to the same datasource names as DEV
    step('LOCAL: hook DbAdapter connection-instances to datasource JNDIs')
    ensure_dbadapter_hook(db_ci_map)

    disconnect()
    info('Done')

main()


⸻

What this script does (and what it doesn’t)
	•	Clones every JDBC datasource from DEV to LOCAL: same Name, JNDI(s), Driver, URL, and driver properties (except any property with “password” in its name).
	•	Targets each datasource to DefaultServer on LOCAL (or first server if DefaultServer isn’t present).
	•	Reads DbAdapter plan on DEV to find which connection-instances (JNDI) use which datasource JNDI (DataSourceName / xADataSourceName), and mirrors that on LOCAL by ensuring the same connection-instances exist with the same DS names, then redeploys DbAdapter.
	•	It does not set JDBC passwords (not readable on DEV). After the run, set the local passwords once in the Console or extend the script to read them from environment variables.

